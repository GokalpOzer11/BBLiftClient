@model IEnumerable<ExerciseResponse>

@{
    ViewBag.Title = "Egzersizler";
    var muscleNames = ViewBag.MuscleNames as Dictionary<Guid, string> ?? new Dictionary<Guid, string>();
    var equipmentNames = ViewBag.EquipmentNames as Dictionary<Guid, string> ?? new Dictionary<Guid, string>();
}

<div class="row m-4">
    <div class="col-lg-12">
        <div class="card">  
            <div class="card-header bg-white">
                <a asp-action="Create" class="btn btn-outline-primary btn-sm">Yeni Ekle</a>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Ad</th>
                            <th>Kas Grubu</th>
                            <th>Ekipman</th>
                            <th>Açıklama</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@(muscleNames.TryGetValue(item.MuscleGroupId, out var muscle) ? muscle : "-")</td>
                                <td>@(equipmentNames.TryGetValue(item.EquipmentId, out var equipment) ? equipment : "-")</td>
                                <td>@item.Description</td>
                                <td class="text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">Düzenle</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Bu egzersiz silinsin mi?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">Henüz egzersiz eklenmemiş.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>