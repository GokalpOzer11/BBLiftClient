@model UpdateMuscleGroupRequest

@{
    ViewBag.Title = "Kas Grubu Düzenle";
}

<div class="row m-4">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white">
                Düzenle
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input asp-for="Id" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Ad</label>
                        <input asp-for="Name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label">Görsel URL'si</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                    </div>
                    <button type="submit" class="btn btn-outline-success btn-sm">Güncelle</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Listeye Dön</a>
                </form>
            </div>
        </div>
    </div>
</div>