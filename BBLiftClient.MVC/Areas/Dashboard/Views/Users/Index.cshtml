@model List<UserResponse>

@{
    ViewBag.Title = "Kullanıcılar";
    var allRoles = ViewBag.AllRoles as string[] ?? Array.Empty<string>();
    var currentUserId = ViewBag.CurrentUserId as string;

    string BadgeClass(string role) => role switch
    {
        "SuperAdmin" => "bg-danger",
        "Admin" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

<div class="row m-4">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header bg-white">
                <div class="fw-semibold">Kullanıcı ve Rol Yönetimi</div>
                <div class="text-muted small">
                    Rol değişiklikleri, kullanıcının bir sonraki girişinde geçerli olur.
                    Kendi SuperAdmin rolünü kaldıramazsın, sistemde en az bir SuperAdmin kalmalıdır.
                </div>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Kullanıcı</th>
                            <th>E-posta</th>
                            <th>Roller</th>
                            <th>Rol Ekle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var isMe = string.Equals(user.Id.ToString(), currentUserId, StringComparison.OrdinalIgnoreCase);
                            var available = allRoles.Where(r => !user.Roles.Contains(r)).ToList();

                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @user.FirstName @user.LastName
                                        @if (isMe)
                                        {
                                            <span class="badge bg-light text-dark border ms-1">Sen</span>
                                        }
                                    </div>
                                    <div class="text-muted small">@@@user.UserName</div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var role in user.Roles)
                                        {
                                            var lockSelf = isMe && role == "SuperAdmin";

                                            <form asp-action="RemoveRole" method="post" class="d-inline m-0"
                                                  onsubmit="return confirm('Bu rol kaldırılsın mı?');">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="role" value="@role" />
                                                <span class="badge @BadgeClass(role) d-inline-flex align-items-center gap-1">
                                                    @role
                                                    @if (!lockSelf)
                                                    {
                                                        <button type="submit" class="btn btn-sm p-0 border-0 lh-1 text-reset" title="Rolü kaldır">&times;</button>
                                                    }
                                                </span>
                                            </form>
                                        }
                                        @if (!user.Roles.Any())
                                        {
                                            <span class="text-muted small">Rol yok</span>
                                        }
                                    </div>
                                </td>
                                <td style="min-width: 220px;">
                                    @if (available.Any())
                                    {
                                        <form asp-action="AddRole" method="post" class="d-flex gap-2 m-0">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <select name="role" class="form-select form-select-sm">
                                                @foreach (var r in available)
                                                {
                                                    <option value="@r">@r</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-outline-success btn-sm">Ekle</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Tüm roller verilmiş</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">Kullanıcı bulunamadı.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>