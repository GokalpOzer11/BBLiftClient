<!DOCTYPE html>
<html class="dark" lang="tr">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" name="viewport">
    <title>@ViewData["Title"] - BBLift</title>

    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <style>
        @@layer base {
            html, body { width: 100%; margin: 0; padding: 0; background-color: #111319; color: #e2e2eb; font-family: 'Inter', sans-serif; }
            body { overscroll-behavior-y: none; -webkit-tap-highlight-color: transparent; }
            .pb-safe { padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 5rem); }
            .pb-nav { padding-bottom: env(safe-area-inset-bottom, 0px); }
            .pt-safe { padding-top: env(safe-area-inset-top, 0px); }
        }
        ::-webkit-scrollbar { display: none; }
        * { -ms-overflow-style: none; scrollbar-width: none; }
    </style>

    <script src="https://cdn.tailwindcss.com"></script>
   <script id="tailwind-config">
        tailwind.config = { 
            darkMode: "class", 
            theme: { 
                extend: { 
                    colors: { "surface-container-high": "#282a30", "tertiary-container": "#9699ff", "surface-container-low": "#191b22", "primary-fixed": "#6ffbbe", "surface": "#111319", "outline-variant": "#3c4a42", "surface-dim": "#111319", "on-error": "#690005", "surface-container": "#1e1f26", "tertiary-fixed": "#e1e0ff", "outline": "#86948a", "inverse-surface": "#e2e2eb", "on-tertiary": "#1000a9", "on-secondary-fixed": "#2a1700", "primary-fixed-dim": "#4edea3", "on-tertiary-container": "#1d17b2", "on-primary-fixed-variant": "#005236", "on-secondary-container": "#5b3800", "error": "#ffb4ab", "background": "#111319", "secondary-fixed-dim": "#ffb95f", "surface-bright": "#373940", "surface-variant": "#33343b", "on-tertiary-fixed-variant": "#2f2ebe", "primary": "#4edea3", "on-error-container": "#ffdad6", "on-background": "#e2e2eb", "on-primary-fixed": "#002113", "secondary-fixed": "#ffddb8", "surface-container-lowest": "#0c0e14", "error-container": "#93000a", "inverse-primary": "#006c49", "secondary": "#ffb95f", "tertiary": "#c0c1ff", "on-secondary-fixed-variant": "#653e00", "surface-container-highest": "#33343b", "inverse-on-surface": "#2e3037", "on-surface-variant": "#bbcabf", "on-secondary": "#472a00", "on-surface": "#e2e2eb", "surface-tint": "#4edea3", "tertiary-fixed-dim": "#c0c1ff", "on-primary-container": "#00422b", "secondary-container": "#ee9800", "on-primary": "#003824", "primary-container": "#10b981", "on-tertiary-fixed": "#07006c" }, 
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" }, 
                    spacing: { "gutter": "1.5rem", "space-md": "1rem", "gutter-mobile": "1rem", "space-sm": "0.5rem", "space-xs": "0.25rem", "margin-mobile": "1rem", "space-xl": "2.5rem", "margin": "2rem", "space-lg": "1.5rem" }, 
                    fontFamily: { "body-md": ["Inter"], "body-lg": ["Inter"], "headline-sm": ["Outfit"], "headline-md": ["Outfit"], "headline-xl": ["Outfit"], "label-numeric-stat": ["Outfit"], "headline-lg": ["Outfit"], "label-ui": ["Outfit"], "display-hero-mobile": ["Outfit"], "display-hero": ["Outfit"], "headline-xl-mobile": ["Outfit"], "body-sm": ["Inter"], "label-badge": ["Outfit"] }, 
                    fontSize: { 
                        "body-md": ["15px", { "lineHeight": "24px", "letterSpacing": "0em", "fontWeight": "400" }], 
                        "body-lg": ["18px", { "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "400" }], 
                        "headline-sm": ["20px", { "lineHeight": "28px", "letterSpacing": "0em", "fontWeight": "600" }], 
                        "headline-md": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }], 
                        "headline-xl": ["44px", { "lineHeight": "52px", "letterSpacing": "-0.02em", "fontWeight": "700" }], 
                        "label-numeric-stat": ["32px", { "lineHeight": "36px", "letterSpacing": "-0.02em", "fontWeight": "800" }], 
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.015em", "fontWeight": "700" }], 
                        "label-ui": ["13px", { "lineHeight": "18px", "letterSpacing": "0.03em", "fontWeight": "600" }], 
                        "display-hero-mobile": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "800" }], 
                        "display-hero": ["64px", { "lineHeight": "72px", "letterSpacing": "-0.03em", "fontWeight": "800" }], 
                        "headline-xl-mobile": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }], 
                        "body-sm": ["13px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "400" }], 
                        "label-badge": ["11px", { "lineHeight": "14px", "letterSpacing": "0.08em", "fontWeight": "700" }] 
                    } 
                } 
            } 
        };
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-surface text-on-surface antialiased flex flex-col min-h-screen">

<header class="fixed top-0 w-full z-50 bg-surface/85 backdrop-blur-xl pt-safe shadow-[0_1px_8px_rgba(0,0,0,0.4)]">
    <div class="max-w-7xl mx-auto h-16 px-gutter-mobile flex items-center justify-between">
        
        <div class="flex items-center gap-space-sm">
            <a href="/" class="flex items-center gap-space-sm group">
                <div class="w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary text-[22px]">fitness_center</span>
                </div>
                <div class="flex flex-col">
                    <span class="font-headline-md text-headline-sm uppercase tracking-tight text-on-surface font-extrabold flex items-center gap-1.5">
                        BBLIFT<span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                    </span>
                    <span class="font-label-badge text-label-badge text-primary uppercase tracking-widest">Antrenman Takibi</span>
                </div>
            </a>
        </div>
        
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            var navController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            var navAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

            var topLinks = new[]
            {
                (Label: "Egzersiz Kütüphanesi", Href: "/Exercise", Active: navController == "Exercise"),
                (Label: "Rutinlerim", Href: "/Routine", Active: navController == "Routine"),
                (Label: "Antrenmanlarım", Href: "/Account/Workouts", Active: navController == "Account" && navAction == "Workouts"),
                (Label: "Üyelik Paketleri", Href: "/MembershipPackage", Active: navController == "MembershipPackage")
            };

            <nav class="hidden lg:flex items-center gap-1">
                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                {
                    <a href="/Dashboard"
                       class="ml-1 px-3 py-2 rounded-lg font-label-ui text-label-ui text-secondary bg-secondary/10 hover:bg-secondary/20 transition-colors inline-flex items-center gap-1">
                        <span class="material-symbols-outlined text-[18px]">admin_panel_settings</span> Yönetim Paneli
                    </a>
                }
                @foreach (var link in topLinks)
                {
                    <a href="@link.Href"
                       class="px-3 py-2 rounded-lg font-label-ui text-label-ui transition-colors @(link.Active ? "text-primary bg-primary/10" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container)")">
                        @link.Label
                    </a>
                }
            </nav>
        }

        <div class="flex items-center gap-space-xs">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                
                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                {
                    <a href="/Dashboard" class="lg:hidden w-11 h-11 flex items-center justify-center rounded-full text-secondary hover:text-primary transition-colors" title="Yönetim Paneli">
                        <span class="material-symbols-outlined text-[24px]">admin_panel_settings</span>
                    </a>
                }
                
                <a href="/Cart" class="w-11 h-11 flex items-center justify-center rounded-full text-on-surface-variant hover:text-primary transition-colors" title="Sepetim">
                    <span class="material-symbols-outlined text-[24px]">shopping_cart</span>
                </a>
                <a href="/Order" class="w-11 h-11 flex items-center justify-center rounded-full text-on-surface-variant hover:text-primary transition-colors" title="Siparişlerim">
                    <span class="material-symbols-outlined text-[24px]">receipt_long</span>
                </a>

                <a href="/Account/Profile" class="flex items-center gap-2 group p-1 rounded-full hover:bg-surface-container transition-all">
                    <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                    </div>
                </a>

                <a href="/Account/Logout" class="p-2 rounded-lg text-on-surface-variant hover:text-error transition-colors" title="Çıkış Yap">
                    <span class="material-symbols-outlined text-[20px]">logout</span>
                </a>
            }
            else
            {
                <a href="/Account/Login" class="font-label-ui text-label-ui text-on-surface-variant hover:text-on-surface transition-colors px-3 py-2">Giriş Yap</a>
                <a href="/Account/Register" class="inline-flex items-center justify-center font-headline-sm text-label-ui uppercase tracking-wide bg-primary-container text-on-primary-container hover:bg-primary px-4 py-2 rounded-lg transition-all shadow-sm">Ücretsiz Başla</a>
            }
        </div>
        
    </div>
</header>

    <main class="flex-1 flex flex-col relative w-full pt-16 pb-safe bg-surface">
        @RenderBody()
    </main>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    var bottomController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var bottomAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var inWorkout = bottomController == "WorkoutSession"
                    && (bottomAction == "Active" || bottomAction == "StartQuick" || bottomAction == "Restart");

    if (!inWorkout)
    {
        <nav class="fixed bottom-0 w-full z-50 pb-nav bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_-4px_24px_rgba(0,0,0,0.6)]">
            <div class="flex justify-center items-center h-12 px-space-md">
                <a href="/WorkoutSession/StartQuick"
                   class="flex items-center gap-2 px-space-lg py-1.5 rounded-full bg-primary text-on-primary font-label-ui text-label-ui font-bold shadow-[0_0_16px_rgba(16,185,129,0.35)] hover:bg-primary-container transition-all active:scale-95">
                    <span class="material-symbols-outlined text-[20px]">play_arrow</span>
                    Antrenman Başlat
                </a>
            </div>
        </nav>
    }
}

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>