@{
ViewData["Title"] = "Aktif Antrenman";
Layout = "_Layout";
var sessionId = ViewBag.SessionId;

var exercises = ViewBag.Exercises as IEnumerable<BBLiftClient.Application.Dtos.ExerciseResponse> ?? new List<BBLiftClient.Application.Dtos.ExerciseResponse>();

var prefillExercises = ViewBag.Prefill as IEnumerable<BBLiftClient.MVC.Models.PrefillExercise>
?? Enumerable.Empty<BBLiftClient.MVC.Models.PrefillExercise>();
}

<div class="flex flex-col w-full min-h-screen pb-32">
    @if (TempData["InfoMessage"] != null)
    {
    <div id="activeWorkoutOverlay" class="fixed inset-0 z-[99] bg-surface-container-lowest/80 backdrop-blur-sm transition-opacity duration-500"></div>

    <div id="activeWorkoutWarning" class="fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-[100] p-space-xl bg-surface-container-high border border-secondary/40 rounded-2xl shadow-[0_0_80px_rgba(245,158,11,0.25)] flex flex-col items-center justify-center gap-4 text-center w-[90%] max-w-[420px]">
        <div class="w-16 h-16 rounded-full bg-secondary/10 flex items-center justify-center shadow-inner">
            <span class="material-symbols-outlined text-[36px] text-secondary">error</span>
        </div>
        <div class="flex flex-col gap-1">
            <h3 class="font-headline-md text-headline-md text-on-surface font-bold">Antrenman Devam Ediyor</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">@TempData["InfoMessage"]</p>
        </div>
    </div>

    <script>
        setTimeout(() => {
            const warning = document.getElementById('activeWorkoutWarning');
            const overlay = document.getElementById('activeWorkoutOverlay');

            if(warning) {
                warning.style.transition = "all 0.5s ease";
                warning.style.opacity = "0";
                warning.style.transform = "translate(-50%, -45%) scale(0.95)";
            }
            if(overlay) {
                overlay.style.transition = "opacity 0.5s ease";
                overlay.style.opacity = "0";
            }

            setTimeout(() => {
                if(warning) warning.remove();
                if(overlay) overlay.remove();
            }, 500);
        }, 4000);
    </script>
    }
    <div class="relative w-full overflow-visible">
        <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[720px] h-[280px] bg-primary/10 blur-[120px] rounded-full pointer-events-none"></div>

        <div class="w-full bg-surface-container-lowest/90 backdrop-blur-xl shadow-2xl px-margin-mobile md:px-margin py-space-md sticky top-16 z-40 border-b border-white/5">
            <div class="max-w-[1440px] mx-auto flex flex-col xl:flex-row items-center justify-between gap-space-md">

                <div class="flex items-center gap-space-md w-full xl:w-auto justify-between xl:justify-start">
                    <div class="flex items-center gap-space-sm">
                        <div class="w-10 h-10 rounded-xl bg-primary-container/20 flex items-center justify-center text-primary shadow-[0_0_16px_rgba(16,185,129,0.2)]">
                            <span class="material-symbols-outlined text-[24px]">fitness_center</span>
                        </div>
                        <div>
                            <div class="flex items-center gap-space-xs group cursor-pointer relative" onclick="enableSessionNameEdit()">
                                <h1 id="sessionNameDisplay" class="font-headline-sm text-headline-sm text-on-surface font-semibold tracking-tight transition-all">@ViewBag.SessionName</h1>

                                <input type="text" id="sessionNameInput"
                                       class="hidden absolute left-0 -top-1 bg-surface-container-highest text-on-surface font-headline-sm text-headline-sm font-semibold tracking-tight rounded-lg px-2 py-1 outline-none border border-primary/50 w-64 shadow-lg focus:ring-1 focus:ring-primary z-50"
                                       value="@ViewBag.SessionName"
                                       onblur="saveSessionName()"
                                       onkeydown="if(event.key === 'Enter') saveSessionName()" />

                                <span id="sessionNameEditIcon" class="material-symbols-outlined text-outline group-hover:text-primary transition-colors text-[18px]">edit</span>
                            </div>
                            <div class="flex flex-wrap items-center gap-space-sm font-body-sm text-body-sm text-on-surface-variant">
                                <span class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[14px] text-primary">schedule</span> Başlangıç: <strong class="text-on-surface">Şimdi</strong>
                                </span>
                                @if (!string.IsNullOrWhiteSpace(ViewBag.RoutineName as string))
                                {
                                <span class="flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[14px] text-secondary">list_alt</span> Rutin: <strong class="text-on-surface">@ViewBag.RoutineName</strong>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center justify-center gap-space-md bg-surface-container-low px-space-lg py-2 rounded-xl shadow-inner w-full xl:w-auto border border-white/5">
                    <div class="flex items-center gap-space-sm">
                        <div class="relative flex items-center justify-center">
                            <span class="w-3 h-3 rounded-full bg-primary animate-ping absolute"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
                        </div>
                        <div class="flex flex-col items-start">
                            <span class="font-label-badge text-label-badge text-outline uppercase tracking-wider">Süre</span>
                            <span class="font-label-numeric-stat text-label-numeric-stat text-primary tracking-tight tabular-nums" id="session-timer">00:00:00</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center justify-between xl:justify-end gap-space-md w-full xl:w-auto">
                    <div class="flex items-center gap-space-xs">
                        <form asp-controller="WorkoutSession" asp-action="Finish" method="post" class="m-0 p-0">
                            <input type="hidden" name="sessionId" value="@sessionId"/>
                            <button type="submit" class="px-space-lg py-2.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-ui text-label-ui font-bold shadow-[0_0_24px_rgba(16,185,129,0.35)] transition-all transform hover:scale-[1.02] flex items-center gap-2">
                                <span class="material-symbols-outlined text-[20px]">check_circle</span>
                                Antrenmanı Bitir
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin py-space-lg w-full relative z-10 mt-4">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">

                <div class="lg:col-span-8 flex flex-col gap-space-lg">

                    <div id="active-exercises-container" class="flex flex-col gap-space-lg">
                    </div>

                    <button type="button" onclick="openExerciseModal()" class="w-full py-space-lg rounded-xl bg-surface-container-low/60 hover:bg-surface-container-high/80 transition-all duration-200 flex flex-col items-center justify-center gap-2 group shadow-sm border-2 border-dashed border-outline/20 hover:border-primary/50">
                        <div class="w-12 h-12 rounded-full bg-primary/10 group-hover:bg-primary group-hover:text-on-primary text-primary flex items-center justify-center transition-all duration-200 shadow-sm">
                            <span class="material-symbols-outlined text-[28px]">add</span>
                        </div>
                        <div class="flex flex-col items-center">
                            <span class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors font-bold">+ Egzersiz Ekle</span>
                            <span class="font-body-sm text-body-sm text-on-surface-variant">Kütüphaneden yeni bir hareket seç</span>
                        </div>
                    </button>

                </div>

                <div class="lg:col-span-4 flex flex-col gap-space-lg lg:sticky lg:top-48">
                    <!-- RIR FAST GUIDE -->
                    <div class="bg-surface-container rounded-xl p-space-lg shadow-xl border border-white/5">
                        <div class="flex items-center justify-between mb-space-sm">
                            <div class="flex items-center gap-space-xs">
                                <span class="material-symbols-outlined text-secondary text-[22px]">speed</span>
                                <span class="font-headline-sm text-headline-sm text-on-surface font-bold">RIR Rehberi</span>
                            </div>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-md">Doğru hipertrofi uyarısı için sete kaç tekrar kala bıraktığınızı belirtin:</p>
                        <div class="space-y-2">
                            <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low">
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 rounded bg-error-container text-error font-mono font-bold text-xs">RIR 0</span>
                                    <span class="font-label-ui text-label-ui text-on-surface font-semibold">Tükeniş (Failure)</span>
                                </div>
                                <span class="text-outline text-xs">0 Tekrar Kaldı</span>
                            </div>
                            <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low">
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 rounded bg-secondary-container/30 text-secondary font-mono font-bold text-xs">RIR 1</span>
                                    <span class="font-label-ui text-label-ui text-on-surface font-semibold">Maksimal Efor</span>
                                </div>
                                <span class="text-secondary text-xs font-semibold">1 Tekrar Çıkabilirdi</span>
                            </div>
                            <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low">
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 rounded bg-primary/20 text-primary font-mono font-bold text-xs">RIR 2</span>
                                    <span class="font-label-ui text-label-ui text-on-surface font-semibold">Optimum Hipertrofi</span>
                                </div>
                                <span class="text-primary text-xs font-semibold">2 Tekrar Rezerve</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="exerciseModal" class="fixed inset-0 z-[100] bg-surface-container-lowest/80 backdrop-blur-md hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
    <div class="w-full max-w-2xl rounded-2xl bg-surface-container-low p-space-lg shadow-2xl flex flex-col gap-space-md relative border border-white/10 transform scale-95 transition-transform duration-300" id="exerciseModalContent">

        <button type="button" onclick="closeExerciseModal()" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-surface-container-high text-on-surface-variant hover:text-on-surface flex items-center justify-center transition-colors">
            <span class="material-symbols-outlined text-[18px]">close</span>
        </button>

        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[24px]">fitness_center</span>
            <h3 class="font-headline-md text-headline-md text-on-surface">Egzersiz Kütüphanesi</h3>
        </div>

        <div class="relative w-full mb-2">
            <span class="material-symbols-outlined absolute left-3 top-3 text-outline">search</span>
            <input type="text" id="modalSearch" placeholder="Egzersiz ara..." onkeyup="filterModalExercises()" class="w-full pl-10 pr-4 py-3 rounded-lg bg-surface-container-lowest text-on-surface placeholder:text-outline font-body-md shadow-inner focus:outline-none focus:ring-1 focus:ring-primary border border-white/5" />
        </div>

        <div class="flex flex-col gap-2 max-h-80 overflow-y-auto pr-2" id="modalExerciseList">
            @foreach (var ex in exercises)
            {
            <div class="exercise-item flex items-center justify-between p-3 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors cursor-pointer border border-transparent hover:border-primary/30" onclick="addExerciseToSession('@ex.Id', '@ex.Name')">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-surface-container-lowest flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[20px]">fitness_center</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-headline-sm text-base text-on-surface ex-name">@ex.Name</span>
                    </div>
                </div>
                <span class="material-symbols-outlined text-primary opacity-0 transition-opacity">add_circle</span>
            </div>
            }
            @if (!exercises.Any())
            {
            <div class="text-center py-6 text-on-surface-variant font-body-sm">
                Kütüphanede gösterilecek egzersiz bulunamadı.
            </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    // --- İSİM DEĞİŞTİRME FONKSİYONLARI ---
    function enableSessionNameEdit() {
        const display = document.getElementById('sessionNameDisplay');
        const input = document.getElementById('sessionNameInput');
        const icon = document.getElementById('sessionNameEditIcon');

        display.classList.add('opacity-0');
        icon.classList.add('hidden');
        input.classList.remove('hidden');

        input.focus();
        const val = input.value;
        input.value = '';
        input.value = val;
    }

    async function saveSessionName() {
        const display = document.getElementById('sessionNameDisplay');
        const input = document.getElementById('sessionNameInput');
        const icon = document.getElementById('sessionNameEditIcon');

        const newName = input.value.trim();
        const oldName = display.textContent;

        if (newName === '') {
            input.value = oldName;
        } else if (newName !== oldName) {
            display.textContent = newName;

            try {
                const response = await fetch('/WorkoutSession/UpdateSession', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id: '@ViewBag.SessionId',
                        name: newName,
                        endTime: null,
                        workOutDurationInSeconds: seconds,
                        status: 1 // GÜNCELLEME: Enum string çeviri hatasından kaçmak için int yolluyoruz (1 = Active)
                    })
                });

                const result = await response.json();

                if (!result.success) {
                    alert("İSİM GÜNCELLENEMEDİ:\n" + (result.message || "API veriyi reddetti."));
                    display.textContent = oldName;
                    input.value = oldName;
                }
            } catch (error) {
                console.error("İsim güncelleme hatası:", error);
                alert("Sunucuya ulaşılamadı.");
                display.textContent = oldName;
                input.value = oldName;
            }
        }

        input.classList.add('hidden');
        icon.classList.remove('hidden');
        display.classList.remove('opacity-0');
    }

    // --- KRONOMETRE ---
    let seconds = 0;
    const timerEl = document.getElementById('session-timer');
    let timerInterval = setInterval(updateTimer, 1000);

    function updateTimer() {
        seconds++;
        const hrs = Math.floor(seconds / 3600).toString().padStart(2, '0');
        const mins = Math.floor((seconds % 3600) / 60).toString().padStart(2, '0');
        const secs = (seconds % 60).toString().padStart(2, '0');
        if (timerEl) timerEl.textContent = `${hrs}:${mins}:${secs}`;
    }

    // --- MODAL ---
    const modal = document.getElementById('exerciseModal');
    const modalContent = document.getElementById('exerciseModalContent');

    function openExerciseModal() {
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modalContent.classList.remove('scale-95');
        }, 10);
        document.getElementById('modalSearch').focus();
    }

    function closeExerciseModal() {
        modal.classList.add('opacity-0');
        modalContent.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }

    function filterModalExercises() {
        const term = document.getElementById('modalSearch').value.toLowerCase();
        const items = document.querySelectorAll('.exercise-item');
        items.forEach(item => {
            const name = item.querySelector('.ex-name').innerText.toLowerCase();
            item.style.display = name.includes(term) ? 'flex' : 'none';
        });
    }

    // --- EGZERSİZ VE SET YÖNETİMİ ---
    let exCounter = 0;
    function addExerciseToSession(id, name) {
        closeExerciseModal();
        exCounter++;

        const container = document.getElementById('active-exercises-container');
        const cardHtml = `
                <div class="bg-surface-container rounded-xl shadow-xl overflow-hidden transition-all duration-300 border border-white/5">
                    <div class="bg-surface-container-high/70 p-space-md flex flex-wrap items-center justify-between gap-space-sm">
                        <div class="flex items-center gap-space-md">
                            <div class="w-8 h-8 rounded-lg bg-surface-container-lowest flex items-center justify-center font-headline-sm text-headline-sm text-primary font-bold">${exCounter}</div>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold tracking-tight">${name}</h2>
                        </div>
                        <button class="p-2 rounded-lg hover:bg-error-container text-on-surface-variant hover:text-error transition-colors" onclick="this.closest('.bg-surface-container').remove();">
                            <span class="material-symbols-outlined text-[18px]">delete_outline</span>
                        </button>
                    </div>
                    
                    <div class="p-space-md overflow-x-auto">
                        <table class="w-full text-left font-body-sm text-body-sm">
                            <thead>
                                <tr class="text-outline uppercase font-label-badge text-label-badge tracking-wider border-b border-white/5">
                                    <th class="py-2 px-2 text-center w-12">SET</th>
                                    <th class="py-2 px-3 text-center">AĞIRLIK (KG)</th>
                                    <th class="py-2 px-3 text-center">TEKRAR</th>
                                    <th class="py-2 px-3 text-center">RIR</th>
                                    <th class="py-2 px-3 text-center">DURUM</th>
                                </tr>
                            </thead>
                            <tbody class="space-y-2" id="tbody-${exCounter}">
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="bg-surface-container-low px-space-md py-2.5 flex items-center justify-center border-t border-white/5">
                        <button class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-surface-container-high hover:bg-surface-bright text-on-surface font-label-ui text-label-ui" onclick="addSetRow(${exCounter}, '${id}')">
                            <span class="material-symbols-outlined text-[16px] text-primary">add</span>
                            <span>Set Ekle</span>
                        </button>
                    </div>
                </div>
            `;

        container.insertAdjacentHTML('beforeend', cardHtml);

        addSetRow(exCounter, id);
    }

    // defaults (isteğe bağlı): { weight, reps, rir } -> önceki antrenmandan gelen hazır değerler
    function addSetRow(cardId, exerciseId, defaults) {
        const tbody = document.getElementById(`tbody-${cardId}`);
        const setIndex = tbody.children.length + 1;

        const weightVal = defaults && defaults.weight ? defaults.weight : '';
        const repsVal = defaults && defaults.reps ? defaults.reps : '';
        const rirVal = defaults && defaults.rir !== null && defaults.rir !== undefined ? String(defaults.rir) : '1';
        const rirOptions = [1, 0, 2, 3]
            .map(v => `<option value="${v}" ${String(v) === rirVal ? 'selected' : ''}>RIR ${v}</option>`)
            .join('');

        const tr = document.createElement('tr');
        tr.className = "bg-surface-container-high rounded-lg shadow-sm border-b border-surface-container-lowest/50 transition-all group";
        tr.innerHTML = `
                <td class="py-3 px-2 text-center font-bold text-on-surface">${setIndex}</td>
                <td class="py-3 px-3 text-center">
                    <input class="w-20 bg-surface-container-lowest text-on-surface text-center py-2 px-1 rounded-lg font-mono font-bold text-lg focus:outline-none focus:ring-1 focus:ring-primary shadow-inner weight-input" type="number" step="0.5" placeholder="0" value="${weightVal}">
                </td>
                <td class="py-3 px-3 text-center">
                    <input class="w-16 bg-surface-container-lowest text-on-surface text-center py-2 px-1 rounded-lg font-mono font-bold text-lg focus:outline-none focus:ring-1 focus:ring-primary shadow-inner reps-input" type="number" placeholder="0" value="${repsVal}">
                </td>
                <td class="py-3 px-3 text-center">
                    <select class="bg-surface-container-lowest text-secondary font-mono font-bold text-sm py-2 px-2 rounded-lg focus:outline-none cursor-pointer rir-select">
                        ${rirOptions}
                    </select>
                </td>
                <td class="py-3 px-3 text-center">
                    <button class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-surface-container hover:bg-primary hover:text-on-primary text-on-surface font-label-ui text-label-ui font-bold shadow-md transition-all save-btn" onclick="toggleSetComplete(this, '${exerciseId}', ${setIndex})">
                        <span class="material-symbols-outlined text-[18px]">check</span>
                    </button>
                </td>
            `;
        tbody.appendChild(tr);
    }

    async function toggleSetComplete(btn, exerciseId, setNumber) {
        const row = btn.closest('tr');
        const weightInput = row.querySelector('.weight-input');
        const repsInput = row.querySelector('.reps-input');
        const rirSelect = row.querySelector('.rir-select');

        const weight = parseFloat(weightInput.value) || 0;
        const reps = parseInt(repsInput.value) || 0;
        const rir = parseInt(rirSelect.value) || 0;

        if (reps === 0) {
            alert("Lütfen tekrar sayısını girin!");
            return;
        }

        btn.innerHTML = `<span class="material-symbols-outlined text-[18px] animate-spin">sync</span>`;
        btn.disabled = true;

        const payload = {
            workoutSessionId: '@ViewBag.SessionId',
            exerciseId: exerciseId,
            setNumber: setNumber,
            weight: weight,
            reps: reps,
            status: 0, // SetStatus: 0 = Normal, 1 = Warmup, 2 = Failure, 3 = DropSet
            rir: rir,
            restTimeInSeconds: null
        };

        try {
            const response = await fetch('/WorkoutSession/SaveSetLog', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            const result = await response.json();

            if (result.success) {
                btn.innerHTML = `<span class="material-symbols-outlined text-[18px]">done_all</span>`;
                btn.classList.replace('bg-surface-container', 'bg-primary');
                btn.classList.replace('text-on-surface', 'text-on-primary');
                row.classList.add('opacity-60');

                weightInput.disabled = true;
                repsInput.disabled = true;
                rirSelect.disabled = true;
            } else {
                alert("Kayıt hatası: " + result.message);
                btn.innerHTML = `<span class="material-symbols-outlined text-[18px]">check</span>`;
                btn.disabled = false;
            }
        } catch (error) {
            console.error("AJAX Hatası:", error);
            alert("Sunucuya bağlanılamadı.");
            btn.innerHTML = `<span class="material-symbols-outlined text-[18px]">check</span>`;
            btn.disabled = false;
        }
    }

    // --- ÖNCEKİ ANTRENMANDAN / RUTİNDEN GELEN HAZIR EGZERSİZLER ---
    const prefillData = @Json.Serialize(prefillExercises);

    // JSON anahtarları PascalCase ya da camelCase gelebilir, ikisini de oku
    function pick(obj, name) {
        if (!obj) return undefined;
        const camel = name.charAt(0).toLowerCase() + name.slice(1);
        return obj[name] !== undefined ? obj[name] : obj[camel];
    }

    function addPrefilledExercise(ex) {
        const exerciseId = pick(ex, 'ExerciseId');
        const name = pick(ex, 'ExerciseName');
        const sets = pick(ex, 'Sets') || [];

        addExerciseToSession(exerciseId, name); // kartı ve 1 boş set satırını oluşturur
        const cardId = exCounter;

        if (sets.length === 0) return;

        document.getElementById(`tbody-${cardId}`).innerHTML = '';
        sets.forEach(s => addSetRow(cardId, exerciseId, {
            weight: pick(s, 'Weight'),
            reps: pick(s, 'Reps'),
            rir: pick(s, 'Rir')
        }));
    }

    prefillData.forEach(addPrefilledExercise);
</script>
}