@model BBLiftClient.Application.Dtos.WorkoutSessionResponse
@{
    ViewData["Title"] = "Antrenman Detayı";
    Layout = "_Layout";
    
    var sessionTitle = !string.IsNullOrWhiteSpace(Model.Name) ? Model.Name : (Model.RoutineId.HasValue ? "Planlı Rutin Antrenmanı" : "Serbest Antrenman");
    var durationMins = Model.EndTime.HasValue ? (Model.EndTime.Value - Model.StartTime).TotalMinutes.ToString("F0") : "Aktif";

    var groupedLogs = ViewBag.GroupedLogs as IEnumerable<IGrouping<string, BBLiftClient.Application.Dtos.WorkoutLogResponse>>;
    
    decimal totalSessionVolume = 0;
    int totalSets = 0;
    
    if (groupedLogs != null)
    {
        foreach (var group in groupedLogs)
        {
            totalSets += group.Count();
        }
    }
}

<div class="flex flex-col w-full min-h-screen pb-32">
    <div class="relative w-full overflow-hidden">
        <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[140px] pointer-events-none"></div>

        <div class="max-w-[1440px] w-full mx-auto px-margin-mobile md:px-margin py-space-lg flex flex-col gap-space-lg relative z-10">
            
            <div class="flex flex-col gap-space-sm mt-8">
                <a asp-controller="Account" asp-action="Workouts" class="inline-flex items-center gap-1 text-on-surface-variant hover:text-primary font-label-ui text-sm transition-colors w-fit">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span> Geçmişe Dön
                </a>
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-space-xs flex-wrap mb-1">
                            <span class="px-space-sm py-0.5 rounded-full bg-primary/20 text-primary font-label-badge text-label-badge uppercase tracking-wider">
                                Antrenman Özeti
                            </span>
                            <span class="px-space-sm py-0.5 rounded-full bg-surface-container-highest text-primary font-label-badge text-label-badge uppercase tracking-wider flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">
                                    @(Model.Status == BBLiftClient.Application.Enums.WorkoutStatus.Completed ? "check_circle" : "pending_actions")
                                </span>
                                @Model.Status
                            </span>
                        </div>
                        <h1 class="font-headline-xl text-headline-xl tracking-tight text-on-surface">@sessionTitle</h1>
                        <p class="font-body-md text-body-md text-on-surface-variant mt-1">
                            @Model.StartTime.ToLocalTime().ToString("dd MMMM yyyy, HH:mm") tarihinde gerçekleştirilen antrenman özeti.
                        </p>
                    </div>

                    <div class="flex flex-wrap sm:flex-nowrap items-center gap-space-xs md:gap-space-sm self-start lg:self-center">
                        <a asp-controller="WorkoutSession" asp-action="Restart" asp-route-id="@Model.Id" class="px-space-md py-2.5 rounded-lg bg-primary-container hover:bg-primary text-on-primary font-label-ui text-label-ui flex items-center gap-2 transition-all shadow-[0_0_16px_rgba(16,185,129,0.25)] hover:scale-[1.02] active:scale-[0.98]">
                            <span class="material-symbols-outlined text-[18px]">replay</span>
                            <span class="">Yeniden Başlat</span>
                        </a>
                    </div>
                </div>
            </div>

            <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md mt-4">
                
                <div class="bg-surface-container-low rounded-xl p-space-md flex flex-col justify-between shadow-md group hover:bg-surface-container transition-colors border border-white/5">
                    <div class="flex items-center justify-between mb-space-sm">
                        <span class="font-label-badge text-label-badge uppercase tracking-wider text-on-surface-variant">Tamamlanan Set & Hareket</span>
                        <span class="material-symbols-outlined text-[20px] text-primary">task_alt</span>
                    </div>
                    <div class="flex flex-col gap-1">
                        <div class="flex items-baseline gap-2">
                            <span class="font-label-numeric-stat text-label-numeric-stat text-on-surface">@totalSets</span>
                            <span class="text-on-surface-variant font-body-sm text-body-sm">Set | </span>
                            <span class="font-label-numeric-stat text-label-numeric-stat text-on-surface">@(groupedLogs?.Count() ?? 0)</span>
                            <span class="text-on-surface-variant font-body-sm text-body-sm">Hareket</span>
                        </div>
                    </div>
                    <div class="w-full bg-surface-container-highest h-1.5 rounded-full mt-3 overflow-hidden">
                        <div class="bg-primary-container h-full rounded-full w-[100%] transition-all duration-700"></div>
                    </div>
                </div>
                
                <div class="bg-surface-container-low rounded-xl p-space-md flex flex-col justify-between shadow-md group hover:bg-surface-container transition-colors border border-white/5">
                    <div class="flex items-center justify-between mb-space-sm">
                        <span class="font-label-badge text-label-badge uppercase tracking-wider text-on-surface-variant">Toplam Süre</span>
                        <span class="material-symbols-outlined text-[20px] text-tertiary">timer</span>
                    </div>
                    <div class="flex flex-col gap-1">
                        <div class="flex items-baseline gap-2">
                            <span class="font-label-numeric-stat text-label-numeric-stat text-on-surface">@durationMins</span>
                            <span class="text-on-surface-variant font-body-sm text-body-sm">dk</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-on-surface-variant font-body-sm text-body-sm mt-1">
                            <span>Bitiş Zamanı: <strong class="text-on-surface">@(Model.EndTime?.ToLocalTime().ToString("HH:mm") ?? "-")</strong></span>
                        </div>
                    </div>
                </div>
            </section>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg mt-4">
                <section class="lg:col-span-8 flex flex-col gap-space-md">
                    
                    <div class="flex items-center justify-between mb-1">
                        <div class="flex items-center gap-space-xs">
                            <h2 class="font-headline-md text-headline-md text-on-surface tracking-tight">Egzersizler ve Set Dökümü</h2>
                            <span class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-badge text-label-badge">
                                @(groupedLogs?.Count() ?? 0) Hareket
                            </span>
                        </div>
                    </div>

                    @if (groupedLogs == null || !groupedLogs.Any())
                    {
                        <div class="w-full py-16 rounded-xl bg-surface-container-low border border-white/5 flex flex-col items-center justify-center text-center">
                            <span class="material-symbols-outlined text-[48px] text-outline mb-4">do_not_disturb_off</span>
                            <h3 class="font-headline-sm text-on-surface font-bold">Bu seansa ait kayıtlı set bulunamadı.</h3>
                            <p class="text-on-surface-variant font-body-sm mt-2">Antrenman sırasında "Tamamla" butonuna basılmamış veya boş kapatılmış olabilir.</p>
                        </div>
                    }
                    else
                    {
                        int exerciseCounter = 1;
                        foreach (var group in groupedLogs)
                        {
                            var exerciseName = group.Key;
                            var sets = group.OrderBy(x => x.SetNumber).ToList();
                            
                            <div class="bg-surface-container-low rounded-xl p-space-md md:p-space-lg shadow-md flex flex-col gap-space-md border border-white/5">
                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-sm pb-space-sm">
                                    <div class="flex items-start gap-space-sm">
                                        <div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center shrink-0">
                                            <span class="material-symbols-outlined text-primary text-[22px]">fitness_center</span>
                                        </div>
                                        <div class="flex flex-col">
                                            <div class="flex flex-wrap items-center gap-space-xs">
                                                <h3 class="font-headline-sm text-headline-sm text-on-surface">@exerciseCounter. @exerciseName</h3>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 self-start md:self-auto bg-surface-container-highest px-3 py-1.5 rounded-lg text-on-surface font-body-sm text-body-sm">
                                        <span class="text-on-surface-variant">Set:</span>
                                        <strong class="font-semibold text-primary">@sets.Count()</strong>
                                    </div>
                                </div>

                                <div class="overflow-x-auto">
                                    <table class="w-full text-left font-body-sm text-body-sm">
                                        <thead>
                                            <tr class="text-on-surface-variant font-label-badge text-label-badge uppercase tracking-wider bg-surface-container-high/60 rounded-lg">
                                                <th class="py-2.5 px-3 rounded-l-lg">Set</th>
                                                <th class="py-2.5 px-3">Ağırlık</th>
                                                <th class="py-2.5 px-3">Tekrar</th>
                                                <th class="py-2.5 px-3">RIR</th>
                                                <th class="py-2.5 px-3">Durum</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y-0">
                                            @foreach (var set in sets)
                                            {
                                                var rirClass = set.Rir == 0 ? "text-error font-bold" : (set.Rir == 1 ? "text-secondary font-semibold" : "text-on-surface-variant");
                                                var rirText = set.Rir == 0 ? "0 RIR (Tükeniş)" : $"{set.Rir} RIR";
                                                
                                                <tr class="hover:bg-surface-container transition-colors border-b border-surface-container-lowest/50">
                                                    <td class="py-3 px-3 font-semibold text-on-surface">@set.SetNumber</td>
                                                    <td class="py-3 px-3 font-semibold text-on-surface">@set.Weight.ToString("0.#") kg</td>
                                                    <td class="py-3 px-3 text-on-surface">@set.Reps</td>
                                                    <td class="py-3 px-3 @rirClass">@rirText</td>
                                                    <td class="py-3 px-3">
                                                        <span class="material-symbols-outlined text-primary text-[18px]">check_circle</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            exerciseCounter++;
                        }
                    }

                </section>
            </div>
        </div>
    </div>
</div>