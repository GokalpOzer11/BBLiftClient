@using System.Globalization
@using BBLiftClient.MVC.Models
@model CartViewModel
@{
    ViewData["Title"] = "Sepetim";
    var tr = CultureInfo.GetCultureInfo("tr-TR");
}

<div class="max-w-5xl mx-auto w-full px-margin-mobile md:px-margin py-space-lg mt-4">

    <div class="flex items-center gap-space-sm mb-space-md">
        <span class="w-1.5 h-4 bg-primary rounded-full"></span>
        <h1 class="font-headline-md text-headline-md text-on-surface">Sepetim</h1>
        <span class="text-on-surface-variant font-label-ui text-label-ui">(@Model.ItemCount ürün)</span>
    </div>

    <partial name="_Flash" />

    @if (!Model.Lines.Any())
    {
        <div class="w-full py-16 rounded-xl bg-surface-container-low border border-white/5 flex flex-col items-center justify-center text-center">
            <span class="material-symbols-outlined text-[48px] text-outline mb-4">shopping_cart</span>
            <h3 class="font-headline-sm text-on-surface font-bold">Sepetin boş.</h3>
            <p class="text-on-surface-variant font-body-sm mt-2 mb-space-md">Üyelik paketlerine göz atarak başlayabilirsin.</p>
            <a href="/MembershipPackage" class="px-space-lg py-space-sm rounded-lg bg-primary text-on-primary font-label-ui text-label-ui font-bold">Paketleri Gör</a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-space-lg items-start">

            <div class="lg:col-span-2 flex flex-col gap-space-md">
                @foreach (var line in Model.Lines)
                {
                    <div class="bg-surface-container-low rounded-xl p-space-md border border-white/5 shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-space-md">
                        <div class="flex items-center gap-space-md min-w-0">
                            <div class="w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center text-primary shrink-0">
                                <span class="material-symbols-outlined">workspace_premium</span>
                            </div>
                            <div class="flex flex-col min-w-0">
                                <span class="font-headline-sm text-[17px] font-bold text-on-surface truncate">@line.PackageName</span>
                                <span class="text-xs text-on-surface-variant">@line.DurationInMonths ay • Birim: @line.UnitPrice.ToString("N2", tr) ₺</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-space-md">
                            <div class="flex items-center gap-1 bg-surface-container rounded-lg p-1">
                                <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="m-0">
                                    <input type="hidden" name="itemId" value="@line.ItemId" />
                                    <input type="hidden" name="quantity" value="@(line.Quantity - 1)" />
                                    <button type="submit" class="w-8 h-8 rounded-md hover:bg-surface-container-high text-on-surface flex items-center justify-center">
                                        <span class="material-symbols-outlined text-[18px]">remove</span>
                                    </button>
                                </form>
                                <span class="w-8 text-center font-bold text-on-surface">@line.Quantity</span>
                                <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="m-0">
                                    <input type="hidden" name="itemId" value="@line.ItemId" />
                                    <input type="hidden" name="quantity" value="@(line.Quantity + 1)" />
                                    <button type="submit" class="w-8 h-8 rounded-md hover:bg-surface-container-high text-on-surface flex items-center justify-center">
                                        <span class="material-symbols-outlined text-[18px]">add</span>
                                    </button>
                                </form>
                            </div>

                            <span class="font-label-numeric-stat text-[20px] font-bold text-on-surface w-28 text-right">@line.LineTotal.ToString("N2", tr) ₺</span>

                            <form asp-controller="Cart" asp-action="Remove" method="post" class="m-0">
                                <input type="hidden" name="itemId" value="@line.ItemId" />
                                <button type="submit" title="Sepetten çıkar" class="p-2 rounded-lg text-outline hover:text-error hover:bg-surface-container-high transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <aside class="bg-surface-container-low rounded-xl p-space-lg border border-white/5 shadow-xl flex flex-col gap-space-md lg:sticky lg:top-24">
                <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold">Sipariş Özeti</h2>

                <div class="flex items-center justify-between text-on-surface-variant font-body-md">
                    <span>Ürün sayısı</span>
                    <span>@Model.ItemCount</span>
                </div>
                <div class="flex items-center justify-between border-t border-white/5 pt-space-sm">
                    <span class="font-label-ui text-label-ui uppercase text-outline">Toplam</span>
                    <span class="font-label-numeric-stat text-[26px] font-extrabold text-primary">@Model.Total.ToString("N2", tr) ₺</span>
                </div>

                <a asp-controller="Checkout" asp-action="Index"
                   class="w-full py-3 rounded-lg bg-primary text-on-primary font-label-ui text-label-ui font-bold text-center shadow-[0_0_24px_rgba(16,185,129,0.35)] hover:bg-primary-container transition-all">
                    Ödemeye Geç
                </a>

                <form asp-controller="Cart" asp-action="Clear" method="post" class="m-0">
                    <button type="submit" class="w-full py-2 rounded-lg bg-surface-container text-on-surface-variant hover:text-error font-label-ui text-label-ui transition-colors">
                        Sepeti Temizle
                    </button>
                </form>
            </aside>
        </div>
    }
</div>