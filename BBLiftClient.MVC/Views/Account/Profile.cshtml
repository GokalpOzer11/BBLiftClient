@model BBLiftClient.Application.Dtos.UserProfileResponse
@{
    ViewData["Title"] = "Sporcu Profili";
    Layout = "_Layout";

    var routines = (ViewBag.Routines as IEnumerable<BBLiftClient.Application.Dtos.RoutineResponse>)
                   ?? Enumerable.Empty<BBLiftClient.Application.Dtos.RoutineResponse>();
    var workoutTitles = (ViewBag.WorkoutTitles as Dictionary<Guid, string>)
                        ?? new Dictionary<Guid, string>();
}

<div class="flex flex-col w-full min-h-screen overflow-x-hidden mt-8">
    <div class="relative w-full max-w-7xl mx-auto px-gutter-mobile lg:px-gutter py-space-lg lg:py-space-xl flex flex-col gap-space-xl">
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-space-sm bg-primary-container/20 border border-primary/30 rounded-lg flex items-center gap-3 shadow-md">
                <span class="material-symbols-outlined text-primary">check_circle</span>
                <span class="text-primary font-body-sm font-medium">@TempData["SuccessMessage"]</span>
            </div>
        }

        <section class="relative rounded-xl bg-surface-container-low p-space-md lg:p-space-lg overflow-hidden shadow-xl border border-white/5">
            <div class="absolute -right-24 -top-24 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
            
            <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-space-lg">
                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-space-md">
                    <div class="relative">
                        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl overflow-hidden bg-surface-container-highest shadow-inner flex items-center justify-center border border-outline/10">
                            <span class="material-symbols-outlined text-6xl text-primary">person</span>
                        </div>
                        <div class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-primary flex items-center justify-center shadow-md border-2 border-surface-container-low">
                            <span class="material-symbols-outlined text-on-primary text-[15px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                        </div>
                    </div>
                    
                    <div class="flex flex-col gap-1">
                        <div class="flex flex-wrap items-center gap-space-xs">
                            <h1 class="font-headline-lg text-headline-lg text-on-surface font-extrabold tracking-tight">@Model.FirstName @Model.LastName</h1>
                            <span class="font-body-md text-on-surface-variant">@@@Model.UserName</span>
                        </div>
                        <p class="font-body-sm text-on-surface-variant max-w-xl mt-1 flex items-center gap-2">
                            <span class="material-symbols-outlined text-[16px] text-outline">mail</span> @Model.Email
                        </p>
                        
                        <div class="flex items-center gap-space-sm pt-3">
                            <span class="px-3 py-1 rounded bg-surface-container text-on-surface-variant font-label-ui text-label-ui border border-white/5">
                                Boy: <span class="text-on-surface font-bold text-base">@Model.Height <span class="text-xs font-normal">cm</span></span>
                            </span>
                            <span class="px-3 py-1 rounded bg-surface-container text-on-surface-variant font-label-ui text-label-ui border border-white/5">
                                Kilo: <span class="text-on-surface font-bold text-base">@Model.Weight <span class="text-xs font-normal">kg</span></span>
                            </span>
                            <span class="px-3 py-1 rounded bg-surface-container text-on-surface-variant font-label-ui text-label-ui border border-white/5 flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">cake</span> @Model.DateOfBirth.ToString("dd.MM.yyyy")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-space-xs w-full lg:w-auto">
                    <a asp-controller="MembershipPackage" asp-action="Index" class="flex-1 sm:flex-none flex items-center justify-center gap-space-xs px-space-md py-space-sm bg-secondary/10 text-secondary rounded-lg font-label-ui text-label-ui hover:bg-secondary/20 transition-all shadow-sm active:scale-95">
                        <span class="material-symbols-outlined text-[18px]">workspace_premium</span>
                        <span>Üyelik Paketleri</span>
                    </a>
                    <a asp-controller="Account" asp-action="Settings" class="flex-1 sm:flex-none flex items-center justify-center gap-space-xs px-space-md py-space-sm bg-surface-container-high text-on-surface rounded-lg font-label-ui text-label-ui hover:bg-surface-bright transition-all active:scale-95 border border-outline/10">
                        <span class="material-symbols-outlined text-on-surface-variant text-[18px]">manage_accounts</span>
                        <span>Profili Düzenle</span>
                    </a>
                </div>
            </div>
        </section>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start mt-4">
            
            <section class="lg:col-span-5 flex flex-col gap-space-md">
                <div class="flex items-center gap-space-xs">
                    <div class="w-2.5 h-2.5 rounded-full bg-primary"></div>
                    <h2 class="font-headline-sm text-headline-sm text-on-surface">Kariyer Özeti</h2>
                </div>
                
                <div class="grid grid-cols-2 gap-space-sm">
                    <div class="p-space-md rounded-xl bg-surface-container-low border border-white/5 flex flex-col justify-between shadow-md">
                        <span class="font-label-ui text-[12px] text-on-surface-variant flex items-center gap-1 uppercase tracking-wider">
                            <span class="material-symbols-outlined text-[16px] text-primary">calendar_month</span> Toplam Antrenman
                        </span>
                        <div class="mt-3 flex items-baseline gap-1">
                            <span class="font-label-numeric-stat text-3xl text-on-surface font-extrabold">@Model.TotalWorkouts</span>
                            <span class="font-body-sm text-on-surface-variant">seans</span>
                        </div>
                    </div>
                    
                    <div class="p-space-md rounded-xl bg-surface-container-low border border-white/5 flex flex-col justify-between shadow-md">
                        <span class="font-label-ui text-[12px] text-on-surface-variant flex items-center gap-1 uppercase tracking-wider">
                            <span class="material-symbols-outlined text-[16px] text-secondary">fitness_center</span> Toplam Hacim
                        </span>
                        <div class="mt-3 flex items-baseline gap-1">
                            <span class="font-label-numeric-stat text-3xl text-secondary font-extrabold">@(Model.TotalVolume >= 1000 ? (Model.TotalVolume / 1000).ToString("0.0") : Model.TotalVolume.ToString("0"))</span>
                            <span class="font-body-sm text-on-surface-variant">@(Model.TotalVolume >= 1000 ? "ton" : "kg")</span>
                        </div>
                    </div>
                </div>

                @if (routines.Any())
                {
                    <div class="flex items-center justify-between mt-2">
                        <div class="flex items-center gap-space-xs">
                            <div class="w-2.5 h-2.5 rounded-full bg-tertiary"></div>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface">Rutinlerim</h2>
                            <span class="text-on-surface-variant font-label-ui text-label-ui">(@routines.Count())</span>
                        </div>
                        <a asp-controller="Routine" asp-action="Index" class="font-label-ui text-label-ui text-primary hover:underline flex items-center gap-0.5">
                            Tümü <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                        </a>
                    </div>

                    <div class="flex flex-col gap-space-xs">
                        @foreach (var routine in routines.Take(5))
                        {
                            var exCount = routine.Exercises?.Count() ?? 0;
                            var totalSets = routine.Exercises?.Sum(e => e.Sets) ?? 0;

                            <div class="bg-surface-container-low p-space-sm rounded-xl border border-white/5 shadow-md flex items-center justify-between gap-space-sm hover:bg-surface-container transition-colors">
                                <a asp-controller="Routine" asp-action="Detail" asp-route-id="@routine.Id"
                                   class="flex items-center gap-space-sm min-w-0 flex-1">
                                    <div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-primary shrink-0">
                                        <span class="material-symbols-outlined">list_alt</span>
                                    </div>
                                    <div class="flex flex-col min-w-0">
                                        <span class="font-headline-sm text-base text-on-surface truncate">@routine.Name</span>
                                        <span class="text-xs text-on-surface-variant">@exCount hareket • @totalSets set</span>
                                    </div>
                                </a>
                                <a asp-controller="WorkoutSession" asp-action="Active" asp-route-routineId="@routine.Id"
                                   title="Bu rutinle başla"
                                   class="p-2 rounded-lg bg-primary text-on-primary hover:bg-primary-container transition-colors shrink-0">
                                    <span class="material-symbols-outlined text-[20px]">play_arrow</span>
                                </a>
                            </div>
                        }
                    </div>

                    <a asp-controller="Routine" asp-action="Create"
                       class="w-full py-3 rounded-xl bg-surface-container-low border border-dashed border-outline/30 text-on-surface-variant hover:text-primary hover:border-primary/50 transition-all flex items-center justify-center gap-space-xs font-label-ui text-label-ui">
                        <span class="material-symbols-outlined text-[20px]">add_circle</span>
                        <span>Yeni Rutin Oluştur</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Routine" asp-action="Create"
                       class="w-full py-4 rounded-xl bg-surface-container-low border border-dashed border-outline/30 text-on-surface-variant hover:text-primary hover:border-primary/50 transition-all flex items-center justify-center gap-space-xs font-label-ui text-label-ui">
                        <span class="material-symbols-outlined">add_circle</span>
                        <span>İlk Antrenman Rutinini Oluştur</span>
                    </a>
                }
            </section>

            <section class="lg:col-span-7 flex flex-col gap-space-md">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-space-xs">
                        <div class="w-2.5 h-2.5 rounded-full bg-secondary"></div>
                        <h2 class="font-headline-sm text-headline-sm text-on-surface">Geçmiş Antrenmanlar</h2>
                    </div>
                    <a asp-controller="Account" asp-action="Workouts" class="font-label-ui text-label-ui text-primary hover:underline flex items-center gap-0.5">
                        Tümü <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    </a>
                </div>

                <div class="flex flex-col gap-3">
                    
                    @if (Model.RecentWorkouts != null && Model.RecentWorkouts.Any())
                    {
                        foreach (var workout in Model.RecentWorkouts)
                        {
                            var displayName = !string.IsNullOrWhiteSpace(workout.Name)
                                ? workout.Name
                                : (workoutTitles.TryGetValue(workout.Id, out var routineTitle) ? routineTitle : "Serbest Antrenman");

                            <a asp-controller="WorkoutSession" asp-action="Detail" asp-route-id="@workout.Id"
                               class="bg-surface-container-low p-4 rounded-xl flex items-center justify-between border border-white/5 shadow-md hover:bg-surface-container transition-colors cursor-pointer">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-primary">
                                        <span class="material-symbols-outlined">fitness_center</span>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="font-headline-sm text-base text-on-surface">@displayName</span>
                                        <span class="text-xs text-on-surface-variant flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[14px]">calendar_today</span> @workout.Date.ToLocalTime().ToString("dd MMM yyyy")
                                            <span class="mx-1 text-outline-variant">•</span>
                                            <span class="material-symbols-outlined text-[14px]">timer</span> @workout.DurationInMinutes dk
                                        </span>
                                    </div>
                                </div>
                                <div class="flex flex-col items-end">
                                    <span class="font-label-numeric-stat text-lg font-bold text-on-surface">@(workout.TotalVolume >= 1000 ? (workout.TotalVolume / 1000).ToString("0.0") : workout.TotalVolume.ToString("0"))<span class="text-xs text-outline font-normal">@(workout.TotalVolume >= 1000 ? "t" : "kg")</span></span>
                                    <span class="text-[10px] text-primary font-bold uppercase tracking-wider">Hacim</span>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="py-8 flex flex-col items-center justify-center text-center bg-surface-container-low rounded-xl border border-white/5">
                            <span class="material-symbols-outlined text-4xl text-outline-variant mb-2">monitoring</span>
                            <span class="font-label-ui text-on-surface">Henüz antrenman kaydın yok.</span>
                            <span class="text-xs text-on-surface-variant mt-1">İlk seansını tamamladığında verilerin burada görünecek.</span>
                        </div>
                    }

                </div>
            </section>

        </div>
    </div>
</div>