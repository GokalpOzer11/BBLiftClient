@{
ViewData["Title"] = "Hesap Ayarları";
Layout = "_Layout";
var profile = ViewBag.Profile as BBLiftClient.Application.Dtos.UserProfileResponse;
}

<!-- Alt menünün (Antrenman) arkasında içerik kalmaması için pb-32 (padding-bottom) eklendi -->
<div class="flex flex-col w-full min-h-screen pb-32">

    <!-- Dikey kaydırmanın kilitlenmemesi için overflow-hidden yerine overflow-x-hidden kullanıldı -->
    <div class="relative w-full overflow-x-hidden">

        <!-- Arka Plan Parlama Efektleri -->
        <div class="absolute -top-32 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-48 right-12 w-80 h-80 bg-secondary/5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-gutter-mobile lg:px-gutter py-space-lg w-full mt-8 relative z-10">

            <!-- Breadcrumb & Page Header -->
            <section class="flex flex-col gap-space-xs mb-space-xl">
                <div class="flex items-center gap-space-xs font-label-ui text-label-ui text-on-surface-variant">
                    <a href="/Account/Profile" class="hover:text-primary transition-colors flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">person</span>
                        <span>Profil</span>
                    </a>
                    <span class="material-symbols-outlined text-[14px] text-outline">chevron_right</span>
                    <span class="text-primary font-medium">Hesap ve Profil Ayarları</span>
                </div>
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md pt-space-xs">
                    <div>
                        <div class="inline-flex items-center gap-space-xs bg-surface-container-high px-space-sm py-1 rounded-full mb-space-xs border border-white/5 shadow-sm">
                            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                            <span class="font-label-badge text-label-badge text-primary uppercase">HESAP AYARLARI</span>
                        </div>
                        <h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">Hesap ve Profil Ayarları</h1>
                        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mt-1">Kişisel bilgilerini, boy ve kilonu ve şifreni buradan yönet.</p>
                    </div>
                    <!-- Quick Athlete Summary Chip -->
                    <div class="flex items-center gap-space-sm bg-surface-container-low p-space-sm rounded-xl shadow-md border border-white/5">
                        <div class="w-11 h-11 rounded-lg bg-surface-container-high flex items-center justify-center text-primary">
                            <span class="material-symbols-outlined text-[24px]">vital_signs</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="font-label-badge text-label-badge text-outline uppercase tracking-wider">AKTİF VERİ DURUMU</span>
                            <span class="font-headline-sm text-headline-sm text-on-surface">Senkronize</span>
                        </div>
                        <div class="w-2.5 h-2.5 rounded-full bg-primary ml-2 shadow-[0_0_8px_rgba(78,222,163,0.8)]"></div>
                    </div>
                </div>
            </section>

            <!-- Hata Mesajları Alanı -->
            @if (!ViewData.ModelState.IsValid)
            {
            <div class="mb-space-lg p-space-sm bg-error-container text-on-error-container rounded-lg font-body-sm text-body-sm shadow-md">
                <div asp-validation-summary="All" class="text-error font-bold"></div>
            </div>
            }

            <!-- Layout Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">

                <!-- Main Form Column (8 cols) -->
                <div class="lg:col-span-8 flex flex-col gap-space-lg">

                    <!-- Section 1: Biometrics & Profile Card -->
                    <section class="bg-surface-container-low/90 backdrop-blur-xl rounded-xl p-space-lg shadow-xl relative overflow-hidden border border-white/5">
                        <div class="absolute top-0 left-0 h-1 w-full bg-gradient-to-r from-primary via-primary-container to-transparent"></div>

                        <div class="flex items-center justify-between pb-space-md mb-space-md bg-surface-container-lowest/40 -mx-space-lg px-space-lg pt-1">
                            <div class="flex items-center gap-space-sm">
                                <div class="w-9 h-9 rounded-lg bg-surface-container-high flex items-center justify-center text-primary border border-white/5">
                                    <span class="material-symbols-outlined text-[20px]">straighten</span>
                                </div>
                                <div>
                                    <h2 class="font-headline-sm text-headline-sm text-on-surface">Kişisel Bilgiler & Fiziksel Profil</h2>
                                    <p class="font-body-sm text-body-sm text-on-surface-variant">Ad, doğum tarihi, boy ve kilo bilgilerin</p>
                                </div>
                            </div>
                        </div>

                        <form asp-controller="Account" asp-action="UpdateProfile" method="post" class="space-y-space-md">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md mb-4">
                                <div class="flex flex-col gap-space-xs">
                                    <label class="font-label-ui text-label-ui text-on-surface">Adınız</label>
                                    <input name="FirstName" type="text" value="@profile?.FirstName" class="w-full bg-surface-container-lowest text-on-surface font-body-md text-base px-space-md py-space-sm rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:bg-surface-container transition-all" required />
                                </div>
                                <div class="flex flex-col gap-space-xs">
                                    <label class="font-label-ui text-label-ui text-on-surface">Soyadınız</label>
                                    <input name="LastName" type="text" value="@profile?.LastName" class="w-full bg-surface-container-lowest text-on-surface font-body-md text-base px-space-md py-space-sm rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:bg-surface-container transition-all" required />
                                </div>
                            </div>

                            <div class="flex flex-col gap-space-xs mb-4">
                                <label class="font-label-ui text-label-ui text-on-surface">Kayıtlı E-Posta Adresi</label>
                                <div class="relative flex items-center">
                                    <input name="Email" type="email" value="@profile?.Email" class="w-full bg-surface-container-lowest text-on-surface font-body-md text-base px-space-md py-space-sm rounded-lg pr-12 focus:outline-none focus:ring-2 focus:ring-primary focus:bg-surface-container transition-all" required />
                                    <span class="absolute right-3 material-symbols-outlined text-[18px] text-primary">verified</span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                                <div class="flex flex-col gap-space-xs">
                                    <label class="font-label-ui text-label-ui text-on-surface flex items-center justify-between">
                                        <span>Boy</span>
                                        <span class="text-outline text-xs">Antropometri</span>
                                    </label>
                                    <div class="relative flex items-center">
                                        <input name="Height" type="text" value="@profile?.Height" class="w-full bg-surface-container-lowest text-on-surface font-label-numeric-stat text-lg px-space-md py-space-sm rounded-lg pr-12 focus:outline-none focus:ring-2 focus:ring-primary focus:bg-surface-container transition-all" required />
                                        <span class="absolute right-3 font-label-badge text-label-badge text-primary bg-primary/10 px-2 py-0.5 rounded">CM</span>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-space-xs">
                                    <label class="font-label-ui text-label-ui text-on-surface flex items-center justify-between">
                                        <span>Güncel Kilo</span>
                                        <span class="text-outline text-xs">Vücut Ağırlığı</span>
                                    </label>
                                    <div class="relative flex items-center">
                                        <input name="Weight" type="text" value="@profile?.Weight" class="w-full bg-surface-container-lowest text-on-surface font-label-numeric-stat text-lg px-space-md py-space-sm rounded-lg pr-12 focus:outline-none focus:ring-2 focus:ring-primary focus:bg-surface-container transition-all" required />
                                        <span class="absolute right-3 font-label-badge text-label-badge text-primary bg-primary/10 px-2 py-0.5 rounded">KG</span>
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-start gap-space-sm bg-surface-container p-space-md rounded-lg mt-4 border border-white/5">
                                <span class="material-symbols-outlined text-primary text-[22px] shrink-0 mt-0.5">info</span>
                                <p class="font-body-sm text-body-sm text-on-surface-variant">Boy ve kilo değerleriniz, antrenmanlarda kaldırılan göreceli kuvvet (<span class="text-on-surface font-medium">Wilks / DOTS</span>) ve toplam tonaj hacim hesaplamalarında otomatik olarak kullanılır.</p>
                            </div>

                            <div class="flex justify-end pt-space-xs">
                                <button type="submit" class="bg-primary text-on-primary hover:bg-primary-fixed transition-all font-label-ui text-label-ui px-space-lg py-space-sm rounded-lg flex items-center gap-space-xs shadow-lg hover:shadow-[0_0_20px_rgba(78,222,163,0.4)] hover:scale-[1.01] active:scale-[0.99]">
                                    <span class="material-symbols-outlined text-[18px]">save</span>
                                    <span>Bilgileri Kaydet</span>
                                </button>
                            </div>
                        </form>
                    </section>

                    <!-- Section 2: Password & Security -->
                    <section class="bg-surface-container-low/90 backdrop-blur-xl rounded-xl p-space-lg shadow-xl relative overflow-hidden border border-white/5">
                        <div class="flex items-center gap-space-sm pb-space-md mb-space-md bg-surface-container-lowest/40 -mx-space-lg px-space-lg pt-1">
                            <div class="w-9 h-9 rounded-lg bg-surface-container-high flex items-center justify-center text-secondary border border-white/5">
                                <span class="material-symbols-outlined text-[20px]">shield_lock</span>
                            </div>
                            <div>
                                <h2 class="font-headline-sm text-headline-sm text-on-surface">Şifre Değiştirme ve Hesap Güvenliği</h2>
                                <p class="font-body-sm text-body-sm text-on-surface-variant">Kriptografik oturum anahtarları ve şifreleme protokolü</p>
                            </div>
                        </div>

                        <form asp-controller="Account" asp-action="ChangePassword" method="post" class="space-y-space-md">
                            <div class="flex flex-col gap-space-xs">
                                <div class="flex items-center justify-between">
                                    <label class="font-label-ui text-label-ui text-on-surface">Mevcut Şifre</label>
                                    <a href="/Account/ForgotPassword" class="font-label-ui text-label-ui text-primary hover:underline">Şifremi Unuttum?</a>
                                </div>
                                <div class="relative flex items-center">
                                    <input name="CurrentPassword" type="password" id="old-pass" class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-lg pr-10 focus:outline-none focus:ring-2 focus:ring-secondary focus:bg-surface-container transition-all" placeholder="Şu anki şifrenizi girin" required />
                                    <button type="button" onclick="togglePasswordVisibility('old-pass')" class="absolute right-3 text-outline hover:text-on-surface">
                                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                                    </button>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                                <div class="flex flex-col gap-space-xs">
                                    <label class="font-label-ui text-label-ui text-on-surface">Yeni Şifre</label>
                                    <div class="relative flex items-center">
                                        <input name="NewPassword" type="password" id="new-pass" oninput="evaluateStrength(this.value)" class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-lg pr-10 focus:outline-none focus:ring-2 focus:ring-secondary focus:bg-surface-container transition-all" placeholder="Yeni güçlü şifre" required />
                                        <button type="button" onclick="togglePasswordVisibility('new-pass')" class="absolute right-3 text-outline hover:text-on-surface">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </button>
                                    </div>
                                    <div class="flex items-center gap-1.5 mt-1">
                                        <div class="h-1 flex-1 bg-surface-container rounded-full overflow-hidden"><div id="str-1" class="h-full bg-secondary w-full opacity-20 transition-opacity"></div></div>
                                        <div class="h-1 flex-1 bg-surface-container rounded-full overflow-hidden"><div id="str-2" class="h-full bg-secondary w-full opacity-20 transition-opacity"></div></div>
                                        <div class="h-1 flex-1 bg-surface-container rounded-full overflow-hidden"><div id="str-3" class="h-full bg-secondary w-full opacity-20 transition-opacity"></div></div>
                                    </div>
                                </div>
                                <div class="flex flex-col gap-space-xs">
                                    <label class="font-label-ui text-label-ui text-on-surface">Yeni Şifre Tekrar</label>
                                    <div class="relative flex items-center">
                                        <input name="ConfirmPassword" type="password" id="new-pass-repeat" class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-lg pr-10 focus:outline-none focus:ring-2 focus:ring-secondary focus:bg-surface-container transition-all" placeholder="Yeni şifrenizi tekrarlayın" required />
                                        <button type="button" onclick="togglePasswordVisibility('new-pass-repeat')" class="absolute right-3 text-outline hover:text-on-surface">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="flex justify-end pt-space-xs">
                                <button type="submit" class="bg-secondary text-on-secondary hover:bg-secondary-fixed transition-all font-label-ui text-label-ui px-space-lg py-space-sm rounded-lg flex items-center gap-space-xs shadow-lg hover:shadow-[0_0_20px_rgba(245,158,11,0.4)] hover:scale-[1.01] active:scale-[0.99]">
                                    <span class="material-symbols-outlined text-[18px]">vpn_key</span>
                                    <span>Şifreyi Değiştir</span>
                                </button>
                            </div>
                        </form>
                    </section>
                </div>

                <!-- Sidebar / Telemetry Column (4 cols) -->
                <div class="lg:col-span-4 flex flex-col gap-space-lg">
                    <div class="bg-surface-container-low/90 backdrop-blur-xl rounded-xl p-space-lg shadow-xl relative overflow-hidden flex flex-col items-center text-center border border-white/5">
                        <div class="relative mb-space-md group">
                            <div class="w-24 h-24 rounded-full overflow-hidden bg-surface-container-highest shadow-[0_0_24px_rgba(78,222,163,0.2)] flex items-center justify-center border border-outline/10">
                                <span class="material-symbols-outlined text-6xl text-primary">person</span>
                            </div>
                        </div>
                        <h3 class="font-headline-sm text-headline-sm text-on-surface">@profile?.FirstName @profile?.LastName</h3>
                        
                        <div class="w-full grid grid-cols-1 gap-space-xs mt-space-md pt-space-md bg-surface-container-lowest/60 rounded-lg p-space-sm border border-white/5">
                            <div class="flex flex-col">
                                <span class="font-label-badge text-label-badge text-outline uppercase">VKİ (BMI)</span>
                                <span class="font-label-numeric-stat text-headline-sm text-on-surface">@((profile?.Weight / ((profile?.Height / 100) * (profile?.Height / 100)))?.ToString("0.0"))</span>
                            </div>
                        </div>
                    </div>

                    <div class="bg-surface-container-low/90 backdrop-blur-xl rounded-xl p-space-lg shadow-xl flex flex-col gap-space-sm border border-white/5">
                        <div class="flex items-center gap-space-xs text-primary">
                            <span class="material-symbols-outlined text-[20px]">security</span>
                            <h4 class="font-headline-sm text-[18px] text-on-surface">Güvenlik Durumu</h4>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Şifreni bu sayfadaki şifre bölümünden istediğin zaman güncelleyebilirsin.</p>
                        <div class="flex flex-col gap-2 mt-space-xs">
                            <div class="flex items-center justify-between text-body-sm bg-surface-container-lowest p-space-sm rounded-lg border border-white/5">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-[18px]">devices</span>
                                    <span class="text-on-surface">Aktif Oturumlar</span>
                                </div>
                                <span class="text-outline font-label-badge">1 Cihaz (Bu Tarayıcı)</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function togglePasswordVisibility(inputId) {
        const input = document.getElementById(inputId);
        if (input) {
            input.type = input.type === 'password' ? 'text' : 'password';
        }
    }
    function evaluateStrength(val) {
        const s1 = document.getElementById('str-1');
        const s2 = document.getElementById('str-2');
        const s3 = document.getElementById('str-3');

        if (!val || val.length < 4) {
            s1.style.opacity = '1'; s1.className = 'h-full bg-error w-full transition-opacity';
            s2.style.opacity = '0.2';
            s3.style.opacity = '0.2';
        } else if (val.length < 8) {
            s1.style.opacity = '1'; s1.className = 'h-full bg-secondary w-full transition-opacity';
            s2.style.opacity = '1'; s2.className = 'h-full bg-secondary w-full transition-opacity';
            s3.style.opacity = '0.2';
        } else {
            s1.style.opacity = '1'; s1.className = 'h-full bg-primary w-full transition-opacity';
            s2.style.opacity = '1'; s2.className = 'h-full bg-primary w-full transition-opacity';
            s3.style.opacity = '1'; s3.className = 'h-full bg-primary w-full transition-opacity';
        }
    }
</script>
}