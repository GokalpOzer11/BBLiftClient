@using BBLiftClient.Application.Dtos
@using BBLiftClient.MVC.Models
@model ExerciseListViewModel
@{
    ViewData["Title"] = "Egzersiz Kütüphanesi";
    Layout = "_Layout";

    var hasFilter = !string.IsNullOrWhiteSpace(Model.Query) || Model.MuscleGroupId.HasValue || Model.EquipmentId.HasValue;

    string TabClass(bool active) =>
        "muscle-tab flex-shrink-0 flex items-center gap-2 px-space-md py-2.5 rounded-lg font-label-ui text-label-ui uppercase tracking-wide shadow-md transition-all "
        + (active
            ? "bg-primary text-on-primary"
            : "bg-surface-container-high text-on-surface-variant hover:bg-surface-container-highest hover:text-on-surface");

    const string PageBtn = "min-w-[40px] h-10 px-3 rounded-lg flex items-center justify-center font-label-ui text-label-ui transition-all ";
    const string PageIdle = "bg-surface-container-high text-on-surface-variant hover:bg-surface-container-highest hover:text-on-surface";
    const string PageActive = "bg-primary text-on-primary font-bold";
}

<div class="w-full pt-4 bg-background flex-1 max-w-7xl mx-auto px-6 lg:px-12 py-space-xl">
    <div class="flex flex-col w-full">

        <div class="relative w-full overflow-hidden">
            <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[720px] h-[280px] bg-primary/10 blur-[120px] rounded-full pointer-events-none"></div>
            <div class="absolute top-12 right-10 w-[360px] h-[220px] bg-secondary/5 blur-[90px] rounded-full pointer-events-none"></div>

            <div class="relative z-10 flex flex-col items-start gap-space-lg pt-space-md pb-space-xl">
                <div class="flex flex-col gap-space-xs max-w-4xl">
                    <h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">
                        Egzersiz <span class="text-primary font-extrabold">Kütüphanesi</span>
                    </h1>
                    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl">
                        Hedef kas grubuna ve ekipmana göre filtrelenebilen hareket arşivi. İstediğin hareketi bul, formunu incele.
                    </p>
                </div>

                <form asp-controller="Exercise" asp-action="Index" method="get"
                      class="w-full max-w-4xl flex flex-col lg:flex-row items-stretch gap-space-sm">
                    <input type="hidden" name="muscleGroupId" value="@Model.MuscleGroupId" />

                    <div class="relative flex-1 group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-on-surface-variant group-focus-within:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[22px]">search</span>
                        </div>
                        <input type="text" id="searchInput" name="q" value="@Model.Query"
                               placeholder="Egzersiz adı, kas grubu veya ekipman ara..."
                               class="w-full pl-12 pr-20 py-3.5 rounded-lg bg-surface-container-high/90 text-on-surface placeholder:text-outline font-body-md text-body-md shadow-md focus:bg-surface-container-highest focus:outline-none focus:ring-1 focus:ring-primary transition-all">
                        <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none">
                            <kbd class="px-2 py-1 rounded bg-surface-container-lowest text-on-surface-variant font-label-badge text-label-badge tracking-widest shadow-inner">⌘K</kbd>
                        </div>
                    </div>

                    <div class="relative lg:w-60">
                        <select name="equipmentId" onchange="this.form.submit()"
                                class="w-full h-full appearance-none px-4 py-3.5 rounded-lg bg-surface-container-high/90 text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary pr-9 cursor-pointer shadow-md">
                            <option value="">Tüm Ekipmanlar</option>
                            @foreach (var equipment in Model.Equipments)
                            {
                                <option value="@equipment.Id" selected="@(Model.EquipmentId == equipment.Id)">@equipment.Name</option>
                            }
                        </select>
                        <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
                    </div>

                    <button type="submit"
                            class="px-space-lg py-3.5 rounded-lg bg-primary text-on-primary font-label-ui text-label-ui uppercase tracking-wide hover:bg-primary-fixed-dim hover:shadow-[0_0_20px_rgba(78,222,163,0.35)] transition-all flex items-center justify-center gap-space-xs">
                        <span class="material-symbols-outlined text-[18px]">search</span>
                        <span>Ara</span>
                    </button>
                </form>
            </div>
        </div>

        <div class="flex flex-col gap-space-md pt-space-xs pb-space-md">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-space-xs">
                    <span class="material-symbols-outlined text-primary text-[20px]">layers</span>
                    <h2 class="font-headline-sm text-headline-sm text-on-surface">Kas Grupları</h2>
                </div>
                <span class="font-body-sm text-body-sm text-on-surface-variant">
                    @Model.TotalCount egzersiz bulundu
                    @if (hasFilter)
                    {
                        <a asp-action="Index" class="ml-2 text-primary hover:underline">Filtreleri temizle</a>
                    }
                </span>
            </div>

            <div class="flex items-center gap-space-xs overflow-x-auto pb-2 scrollbar-none">
                <a asp-action="Index" asp-route-q="@Model.Query" asp-route-equipmentId="@Model.EquipmentId"
                   class="@TabClass(!Model.MuscleGroupId.HasValue)">
                    <span class="material-symbols-outlined text-[18px]">select_all</span>
                    <span>Tüm Egzersizler</span>
                    <span class="ml-1 px-1.5 py-0.5 rounded-full bg-black/20 text-[11px] font-bold">@Model.AllCount</span>
                </a>

                @foreach (var muscle in Model.MuscleGroups)
                {
                    <a asp-action="Index" asp-route-q="@Model.Query" asp-route-equipmentId="@Model.EquipmentId" asp-route-muscleGroupId="@muscle.Id"
                       class="@TabClass(Model.MuscleGroupId == muscle.Id)">
                        <span class="material-symbols-outlined text-[18px]">accessibility_new</span>
                        <span>@muscle.Name</span>
                    </a>
                }
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-space-md items-start pb-space-lg">

            @if (Model.Items.Any())
            {
                foreach (var exercise in Model.Items)
                {
                    var muscleName = Model.MuscleNames.TryGetValue(exercise.MuscleGroupId, out var mn) ? mn : "-";
                    var equipmentName = Model.EquipmentNames.TryGetValue(exercise.EquipmentId, out var en) ? en : "-";

                    <div class="exercise-card group flex flex-col justify-between rounded-xl bg-surface-container-low hover:bg-surface-container p-space-md transition-all duration-200 shadow-md border border-white/5 hover:border-primary/30 hover:-translate-y-0.5">
                        <div class="flex flex-col gap-space-sm">

                            <div class="relative w-full h-36 rounded-lg overflow-hidden bg-surface-container-high border border-surface-container-highest flex items-center justify-center">
                                <span class="material-symbols-outlined text-6xl text-outline/20 group-hover:scale-110 transition-transform duration-500">fitness_center</span>
                                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/90 via-surface-container-lowest/20 to-transparent"></div>

                                <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-center justify-between gap-1 text-on-surface">
                                    <span class="font-label-badge text-label-badge px-2 py-0.5 rounded bg-surface-container-high/90 uppercase text-on-surface-variant border border-white/10 truncate">
                                        @equipmentName
                                    </span>
                                    <span class="font-label-badge text-label-badge text-primary-fixed bg-surface-container-lowest/80 px-1.5 py-0.5 rounded border border-primary/20 truncate">
                                        @muscleName
                                    </span>
                                </div>
                            </div>

                            <div class="flex flex-col gap-1 pt-1">
                                <h3 class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors line-clamp-1">
                                    @exercise.Name
                                </h3>
                                <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2 min-h-[40px]">
                                    @exercise.Description
                                </p>
                            </div>
                        </div>

                        <div class="flex items-center pt-space-md mt-auto">
                            <a asp-action="Detail" asp-route-id="@exercise.Id"
                               class="flex-1 py-2 px-space-sm rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-ui text-label-ui uppercase tracking-wide transition-colors flex items-center justify-center gap-1.5 border border-white/5 shadow-sm">
                                <span class="material-symbols-outlined text-[16px]">visibility</span>
                                <span>Formu İncele</span>
                            </a>
                        </div>
                    </div>
                }
            }
            else if (Model.AllCount == 0)
            {
                <div class="col-span-full py-16 flex flex-col items-center justify-center text-on-surface-variant border-2 border-dashed border-outline/20 rounded-xl bg-surface-container-lowest/50">
                    <span class="material-symbols-outlined text-5xl mb-3 text-outline/50">fitness_center</span>
                    <p class="font-headline-sm text-on-surface">Kütüphane Şu An Boş</p>
                    <p class="font-body-sm mt-1 text-center max-w-md">Yönetim panelinden egzersiz eklendiğinde burada listelenecektir.</p>
                </div>
            }
            else
            {
                <div class="col-span-full py-16 flex flex-col items-center justify-center text-on-surface-variant border-2 border-dashed border-outline/20 rounded-xl bg-surface-container-lowest/50">
                    <span class="material-symbols-outlined text-5xl mb-3 text-outline/50">search_off</span>
                    <p class="font-headline-sm text-on-surface">Aramana uygun egzersiz bulunamadı</p>
                    <a asp-action="Index" class="mt-3 px-space-md py-2 rounded-lg bg-primary text-on-primary font-label-ui text-label-ui font-bold">Filtreleri Temizle</a>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="flex items-center justify-center gap-space-xs pb-space-xl">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-route-q="@Model.Query" asp-route-muscleGroupId="@Model.MuscleGroupId"
                       asp-route-equipmentId="@Model.EquipmentId" asp-route-page="@(Model.Page - 1)"
                       class="@(PageBtn + PageIdle)">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </a>
                }

                @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                {
                    <a asp-action="Index" asp-route-q="@Model.Query" asp-route-muscleGroupId="@Model.MuscleGroupId"
                       asp-route-equipmentId="@Model.EquipmentId" asp-route-page="@p"
                       class="@(PageBtn + (p == Model.Page ? PageActive : PageIdle))">@p</a>
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-q="@Model.Query" asp-route-muscleGroupId="@Model.MuscleGroupId"
                       asp-route-equipmentId="@Model.EquipmentId" asp-route-page="@(Model.Page + 1)"
                       class="@(PageBtn + PageIdle)">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </a>
                }
            </nav>
        }
    </div>
</div>

<style>
    .scrollbar-none::-webkit-scrollbar { display: none; }
    .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
    window.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            const input = document.getElementById('searchInput');
            input.focus();
            input.select();
        }
    });
</script>