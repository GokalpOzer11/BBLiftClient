@using System.Globalization
@using BBLiftClient.Application.Dtos
@using BBLiftClient.Application.Enums
@model List<OrderResponse>
@{
    ViewData["Title"] = "Siparişlerim";
    var tr = CultureInfo.GetCultureInfo("tr-TR");

    (string Label, string Css) StatusInfo(OrderStatus status) => status switch
    {
        OrderStatus.Completed => ("Tamamlandı", "bg-primary/15 text-primary"),
        OrderStatus.Pending => ("Beklemede", "bg-secondary/15 text-secondary"),
        OrderStatus.Failed => ("Başarısız", "bg-error-container/40 text-error"),
        _ => ("İptal", "bg-surface-container-high text-on-surface-variant")
    };
}

<div class="max-w-5xl mx-auto w-full px-margin-mobile md:px-margin py-space-lg mt-4">

    <div class="flex items-center gap-space-sm mb-space-md">
        <span class="w-1.5 h-4 bg-primary rounded-full"></span>
        <h1 class="font-headline-md text-headline-md text-on-surface">Siparişlerim</h1>
        <span class="text-on-surface-variant font-label-ui text-label-ui">(@Model.Count)</span>
    </div>

    <partial name="_Flash" />

    @if (!Model.Any())
    {
        <div class="w-full py-16 rounded-xl bg-surface-container-low border border-white/5 flex flex-col items-center justify-center text-center">
            <span class="material-symbols-outlined text-[48px] text-outline mb-4">receipt_long</span>
            <h3 class="font-headline-sm text-on-surface font-bold">Henüz siparişin yok.</h3>
            <a href="/MembershipPackage" class="mt-space-md px-space-lg py-space-sm rounded-lg bg-primary text-on-primary font-label-ui text-label-ui font-bold">Paketleri Gör</a>
        </div>
    }
    else
    {
        <div class="flex flex-col gap-space-md">
            @foreach (var order in Model)
            {
                var info = StatusInfo(order.Status);

                <div class="bg-surface-container-low rounded-xl p-space-md border border-white/5 shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-space-md">
                    <div class="flex items-center gap-space-md min-w-0">
                        <div class="w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center text-primary shrink-0">
                            <span class="material-symbols-outlined">workspace_premium</span>
                        </div>
                        <div class="flex flex-col min-w-0">
                            <span class="font-headline-sm text-[17px] font-bold text-on-surface truncate">@order.PackageName</span>
                            <span class="text-xs text-on-surface-variant">Sipariş No: @order.Id.ToString()[..8].ToUpperInvariant()</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-space-md">
                        <span class="font-label-numeric-stat text-[20px] font-bold text-on-surface">@order.TotalAmount.ToString("N2", tr) ₺</span>
                        <span class="px-3 py-1 rounded-full font-label-badge text-[11px] uppercase tracking-wider @info.Css">@info.Label</span>
                    </div>
                </div>
            }
        </div>
    }
</div>