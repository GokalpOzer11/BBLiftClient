@using BBLiftClient.Application.Dtos
@model BBLiftClient.MVC.Models.CreateRoutineViewModel
@{
    ViewData["Title"] = "Yeni Rutin";
    var exercises = (ViewBag.Exercises as IEnumerable<ExerciseResponse>)
                    ?? Enumerable.Empty<ExerciseResponse>();
}

<div class="relative w-full overflow-hidden">
    <div class="absolute -top-32 left-1/4 w-96 h-96 bg-primary-container/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 right-10 w-80 h-80 bg-secondary-container/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin py-space-lg w-full relative">

        <form id="routine-form" asp-controller="Routine" asp-action="Create" method="post">
            <input type="hidden" asp-for="ExercisesJson" id="ExercisesJson" />

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">

                <!-- SOL: Rutin ve seçilen egzersizler -->
                <section class="lg:col-span-7 flex flex-col gap-space-lg">

                    <div class="bg-surface-container-low/90 backdrop-blur-xl rounded-xl p-space-lg shadow-xl shadow-black/40 flex flex-col gap-space-md">

                        <div asp-validation-summary="ModelOnly"
                             class="rounded-lg bg-error-container/30 text-error font-body-sm text-body-sm px-space-md py-space-sm empty:hidden"></div>

                        <div class="flex flex-col">
                            <label asp-for="Name"
                                   class="block font-label-badge text-label-badge uppercase tracking-wider text-outline mb-1">
                                Rutin Adı
                            </label>
                            <input asp-for="Name" maxlength="100"
                                   placeholder="Örn: İtiş A — Göğüs & Omuz"
                                   class="w-full bg-surface-container-lowest text-on-surface font-headline-md text-headline-md font-semibold px-space-md py-space-sm rounded-lg focus:outline-none focus:bg-surface-container transition-all" />
                            <span asp-validation-for="Name" class="text-error font-body-sm text-body-sm mt-1"></span>
                        </div>

                        <div class="grid grid-cols-3 gap-space-sm">
                            <div class="bg-surface-container rounded-lg p-space-sm flex flex-col">
                                <span class="font-label-badge text-label-badge uppercase text-outline">Egzersiz</span>
                                <span id="stat-count" class="font-label-numeric-stat text-label-numeric-stat text-secondary">0</span>
                            </div>
                            <div class="bg-surface-container rounded-lg p-space-sm flex flex-col">
                                <span class="font-label-badge text-label-badge uppercase text-outline">Toplam Set</span>
                                <span id="stat-sets" class="font-label-numeric-stat text-label-numeric-stat text-primary">0</span>
                            </div>
                            <div class="bg-surface-container rounded-lg p-space-sm flex flex-col">
                                <span class="font-label-badge text-label-badge uppercase text-outline">Toplam Hacim</span>
                                <div class="flex items-baseline gap-1">
                                    <span id="stat-volume" class="font-label-numeric-stat text-label-numeric-stat text-on-surface">0</span>
                                    <span class="font-body-sm text-body-sm text-on-surface-variant">kg</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center justify-between gap-space-md pt-space-sm">
                            <a asp-action="Index"
                               class="px-space-md py-space-sm rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-label-ui text-label-ui transition-all">
                                Vazgeç
                            </a>
                            <button type="submit"
                                    class="group relative px-space-lg py-space-sm rounded-lg bg-primary text-on-primary font-headline-sm text-[16px] font-bold shadow-lg shadow-primary/20 hover:shadow-primary/40 hover:scale-[1.01] transition-all flex items-center gap-space-xs">
                                <span>Rutini Kaydet</span>
                                <span class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-1">arrow_forward</span>
                            </button>
                        </div>
                    </div>

                    <div class="flex items-center justify-between px-space-xs">
                        <div class="flex items-center gap-space-sm">
                            <span class="w-1.5 h-4 bg-primary rounded-full"></span>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface">Planlanan Egzersiz Sıralaması</h2>
                            <span id="header-count" class="text-on-surface-variant font-label-ui text-label-ui font-normal">(0 Egzersiz)</span>
                        </div>
                    </div>

                    <div id="selected-list" class="flex flex-col gap-space-md"></div>

                    <div id="empty-state"
                         class="bg-surface-container/40 rounded-xl p-space-lg text-center text-on-surface-variant font-body-md text-body-md">
                        Henüz egzersiz eklemedin. Sağdaki egzersiz havuzundan "Rutine Ekle" ile seçebilirsin.
                    </div>
                </section>

                <!-- SAĞ: Egzersiz havuzu -->
                <aside class="lg:col-span-5 flex flex-col gap-space-md">
                    <div class="sticky top-20 bg-surface-container-low/95 backdrop-blur-2xl rounded-xl p-space-md shadow-2xl flex flex-col gap-space-md">

                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-space-xs">
                                <span class="material-symbols-outlined text-primary text-[22px]">auto_stories</span>
                                <h3 class="font-headline-sm text-headline-sm text-on-surface">Egzersiz Havuzu</h3>
                            </div>
                            <span class="px-space-xs py-0.5 rounded bg-surface-container-highest text-on-surface-variant font-label-badge text-label-badge uppercase">
                                @exercises.Count() Egzersiz
                            </span>
                        </div>

                        <div class="relative w-full">
                            <span class="material-symbols-outlined absolute left-space-md top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
                            <input id="library-search" type="text" autocomplete="off"
                                   placeholder="Egzersiz ara..."
                                   class="w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md pl-10 pr-14 py-2.5 rounded-lg focus:outline-none focus:bg-surface-container transition-all" />
                            <span class="absolute right-space-sm top-1/2 -translate-y-1/2 px-1.5 py-0.5 rounded bg-surface-container text-outline font-label-badge text-[10px] tracking-wider uppercase">
                                Ctrl K
                            </span>
                        </div>

                        <div id="library-list" class="flex flex-col gap-space-xs max-h-[60vh] overflow-y-auto pr-1">
                            @foreach (var ex in exercises)
                            {
                                <div class="group bg-surface-container rounded-lg p-space-sm hover:bg-surface-container-high transition-all flex items-start justify-between gap-space-xs shadow-sm"
                                     data-exercise
                                     data-id="@ex.Id"
                                     data-name="@ex.Name"
                                     data-desc="@ex.Description">
                                    <div class="min-w-0">
                                        <h4 class="font-headline-sm text-[15px] font-bold text-on-surface group-hover:text-primary transition-colors">@ex.Name</h4>
                                        @if (!string.IsNullOrWhiteSpace(ex.Description))
                                        {
                                            <p class="font-body-sm text-[12px] text-on-surface-variant mt-0.5 line-clamp-2">@ex.Description</p>
                                        }
                                    </div>
                                    <button type="button" data-add
                                            class="px-space-sm py-1 rounded-md bg-primary-container text-on-primary font-label-ui text-[12px] font-bold hover:bg-primary transition-transform active:scale-95 flex items-center gap-1 shadow-sm shrink-0 disabled:opacity-50 disabled:cursor-default">
                                    </button>
                                </div>
                            }
                            <div id="no-result" style="display:none"
                                 class="text-center text-on-surface-variant font-body-sm text-body-sm py-space-md">
                                Aramana uygun egzersiz bulunamadı.
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </form>
    </div>
</div>

<script>
(function () {
    const form = document.getElementById('routine-form');
    const hidden = document.getElementById('ExercisesJson');
    const list = document.getElementById('selected-list');
    const emptyState = document.getElementById('empty-state');
    const search = document.getElementById('library-search');
    const noResult = document.getElementById('no-result');
    const statCount = document.getElementById('stat-count');
    const statSets = document.getElementById('stat-sets');
    const statVolume = document.getElementById('stat-volume');
    const headerCount = document.getElementById('header-count');

    // Havuzdaki egzersizleri sayfadan oku
    const library = new Map();
    document.querySelectorAll('[data-exercise]').forEach(el => {
        library.set(el.dataset.id.toLowerCase(), {
            id: el.dataset.id.toLowerCase(),
            name: el.dataset.name || '',
            desc: el.dataset.desc || '',
            el: el,
            btn: el.querySelector('[data-add]')
        });
    });

    // Doğrulama hatasıyla sayfa yeniden geldiyse seçilenleri geri yükle
    let selected = [];
    try {
        const parsed = JSON.parse(hidden.value || '[]');
        if (Array.isArray(parsed)) {
            selected = parsed
                .filter(x => x && library.has(String(x.exerciseId).toLowerCase()))
                .map(x => ({
                    exerciseId: String(x.exerciseId).toLowerCase(),
                    sets: x.sets || 3,
                    weight: x.weight || 0,
                    reps: x.reps || 10,
                    restTimeInSeconds: x.restTimeInSeconds ?? null
                }));
        }
    } catch (e) { selected = []; }

    function esc(s) {
        return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    const inputCls = 'w-full bg-surface-container-low text-on-surface font-headline-sm text-[15px] font-bold rounded-md px-2 py-1 focus:outline-none focus:bg-surface-container-high';

    function field(label, name, value, attrs) {
        return '<label class="block">' +
            '<span class="block font-label-badge text-label-badge uppercase text-outline mb-1">' + label + '</span>' +
            '<input type="number" inputmode="decimal" data-field="' + name + '" value="' + (value ?? '') + '" ' + attrs + ' class="' + inputCls + '">' +
            '</label>';
    }

    function btn(action, title, icon, extra) {
        return '<button type="button" data-action="' + action + '" title="' + title + '" ' +
            'class="p-1 rounded text-outline ' + (extra || 'hover:text-on-surface') + ' hover:bg-surface-container-highest transition-colors">' +
            '<span class="material-symbols-outlined text-[18px]">' + icon + '</span></button>';
    }

    function rowHtml(item, i) {
        const ex = library.get(item.exerciseId);
        return '<div class="bg-surface-container/80 rounded-xl p-space-md shadow-md" data-index="' + i + '">' +
            '<div class="flex items-start gap-space-md">' +
                '<div class="pt-1"><span class="font-label-badge text-label-badge text-primary">' + String(i + 1).padStart(2, '0') + '</span></div>' +
                '<div class="flex-1 min-w-0">' +
                    '<div class="flex items-center justify-between gap-space-xs mb-space-sm">' +
                        '<h3 class="font-headline-sm text-[17px] font-bold text-on-surface truncate">' + esc(ex.name) + '</h3>' +
                        '<div class="flex items-center gap-1 shrink-0">' +
                            btn('up', 'Yukarı Taşı', 'keyboard_arrow_up') +
                            btn('down', 'Aşağı Taşı', 'keyboard_arrow_down') +
                            btn('remove', 'Egzersizi Sil', 'delete', 'hover:text-error') +
                        '</div>' +
                    '</div>' +
                    '<div class="grid grid-cols-2 sm:grid-cols-4 gap-space-xs bg-surface-container-lowest/60 rounded-lg p-space-sm">' +
                        field('Set', 'sets', item.sets, 'min="1" step="1" required') +
                        field('Ağırlık (kg)', 'weight', item.weight, 'min="0" step="0.25" required') +
                        field('Tekrar', 'reps', item.reps, 'min="1" step="1" required') +
                        field('Dinlenme (sn)', 'restTimeInSeconds', item.restTimeInSeconds, 'min="0" step="5" placeholder="-"') +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</div>';
    }

    function updateStats() {
        const sets = selected.reduce((s, x) => s + (x.sets || 0), 0);
        const volume = selected.reduce((s, x) => s + (x.sets || 0) * (x.reps || 0) * (x.weight || 0), 0);
        statCount.textContent = selected.length;
        statSets.textContent = sets;
        statVolume.textContent = Math.round(volume).toLocaleString('tr-TR');
        headerCount.textContent = '(' + selected.length + ' Egzersiz)';
    }

    function syncLibrary() {
        const ids = new Set(selected.map(x => x.exerciseId));
        library.forEach(ex => {
            const added = ids.has(ex.id);
            ex.btn.disabled = added;
            ex.btn.innerHTML = added
                ? '<span class="material-symbols-outlined text-[14px]">check</span> Eklendi'
                : '<span class="material-symbols-outlined text-[14px]">add</span> Rutine Ekle';
        });
    }

    function render() {
        list.innerHTML = selected.map((item, i) => rowHtml(item, i)).join('');
        emptyState.style.display = selected.length ? 'none' : '';
        syncLibrary();
        updateStats();
    }

    // Havuzdan ekle
    document.getElementById('library-list').addEventListener('click', function (e) {
        const addBtn = e.target.closest('[data-add]');
        if (!addBtn) return;
        const id = addBtn.closest('[data-exercise]').dataset.id.toLowerCase();
        if (selected.some(x => x.exerciseId === id)) return;
        selected.push({ exerciseId: id, sets: 3, weight: 0, reps: 10, restTimeInSeconds: 90 });
        render();
    });

    // Sıra değiştir / sil
    list.addEventListener('click', function (e) {
        const actionBtn = e.target.closest('[data-action]');
        if (!actionBtn) return;
        const row = actionBtn.closest('[data-index]');
        const i = parseInt(row.dataset.index, 10);
        const action = actionBtn.dataset.action;

        if (action === 'remove') {
            selected.splice(i, 1);
        } else if (action === 'up' && i > 0) {
            [selected[i - 1], selected[i]] = [selected[i], selected[i - 1]];
        } else if (action === 'down' && i < selected.length - 1) {
            [selected[i + 1], selected[i]] = [selected[i], selected[i + 1]];
        }
        render();
    });

    // Set / ağırlık / tekrar / dinlenme değişince state'i güncelle
    list.addEventListener('input', function (e) {
        const input = e.target.closest('[data-field]');
        if (!input) return;
        const i = parseInt(input.closest('[data-index]').dataset.index, 10);
        const name = input.dataset.field;
        const raw = input.value;

        if (name === 'weight') selected[i].weight = raw === '' ? 0 : parseFloat(raw);
        else if (name === 'restTimeInSeconds') selected[i].restTimeInSeconds = raw === '' ? null : parseInt(raw, 10);
        else selected[i][name] = raw === '' ? 0 : parseInt(raw, 10);

        updateStats();
    });

    // Arama
    search.addEventListener('input', function () {
        const q = search.value.trim().toLocaleLowerCase('tr-TR');
        let visible = 0;
        library.forEach(ex => {
            const text = (ex.name + ' ' + ex.desc).toLocaleLowerCase('tr-TR');
            const match = !q || text.includes(q);
            ex.el.style.display = match ? '' : 'none';
            if (match) visible++;
        });
        noResult.style.display = visible ? 'none' : '';
    });
    search.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') e.preventDefault(); // aramada Enter formu göndermesin
    });
    window.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            search.focus();
            search.select();
        }
    });

    // Gönderirken listeyi hidden alana yaz
    form.addEventListener('submit', function () {
        hidden.value = JSON.stringify(selected.map(x => ({
            exerciseId: x.exerciseId,
            sets: Number.isFinite(x.sets) ? x.sets : 0,
            weight: Number.isFinite(x.weight) ? x.weight : 0,
            reps: Number.isFinite(x.reps) ? x.reps : 0,
            restTimeInSeconds: Number.isFinite(x.restTimeInSeconds) ? x.restTimeInSeconds : null
        })));
    });

    render();
})();
</script>